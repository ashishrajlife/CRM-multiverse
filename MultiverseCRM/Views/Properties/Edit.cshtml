@model MultiverseCRM.ViewModels.PropertyEditViewModel
@{
    ViewData["Title"] = $"Edit — {Model.Property.UnitNumber}";
    var p = Model.Property;
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none small text-muted">
        <i class="bi bi-arrow-left me-1"></i>Back to Property
    </a>
    <h3 class="fw-bold mb-1 mt-1">Edit Property</h3>
    <p class="text-muted mb-0 small">@p.UnitNumber @(string.IsNullOrEmpty(p.Title) ? "" : "— " + p.Title)</p>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Property.Id" />

    <!-- Identification -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-house me-1 text-primary"></i> Identification</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Unit Number *</label>
                        <input asp-for="Property.UnitNumber" class="form-control" required maxlength="50" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Title</label>
                        <input asp-for="Property.Title" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Project (optional)</label>
                        <select asp-for="Property.ProjectId" class="form-select">
                            <option value="">— Standalone —</option>
                            @foreach (var proj in Model.AvailableProjects)
                            {
                                <option value="@proj.Id" selected="@(p.ProjectId == proj.Id)">@proj.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Specifications -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-rulers me-1 text-info"></i> Specifications</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Property Type</label>
                        <select asp-for="Property.PropertyType" class="form-select">
                            <option value="">Select…</option>
                            <option>Flat</option>
                            <option>Villa</option>
                            <option>Plot</option>
                            <option>Shop</option>
                            <option>Office</option>
                            <option>Penthouse</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">BHK</label>
                        <select asp-for="Property.BHK" class="form-select">
                            <option value="">Select…</option>
                            <option>1 BHK</option>
                            <option>2 BHK</option>
                            <option>3 BHK</option>
                            <option>4 BHK</option>
                            <option>5 BHK</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Furnished</label>
                        <select asp-for="Property.Furnished" class="form-select">
                            <option value="">Select…</option>
                            <option>Unfurnished</option>
                            <option>Semi-Furnished</option>
                            <option>Fully-Furnished</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Facing</label>
                        <select asp-for="Property.Facing" class="form-select">
                            <option value="">Select…</option>
                            <option>North</option>
                            <option>South</option>
                            <option>East</option>
                            <option>West</option>
                            <option>North-East</option>
                            <option>North-West</option>
                            <option>South-East</option>
                            <option>South-West</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Floor #</label>
                        <input asp-for="Property.FloorNumber" class="form-control" type="number" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Total Floors</label>
                        <input asp-for="Property.TotalFloors" class="form-control" type="number" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Area -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-arrows-fullscreen me-1 text-success"></i> Area</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Carpet Area</label>
                        <input asp-for="Property.CarpetArea" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Unit</label>
                        <select asp-for="Property.AreaUnit" class="form-select">
                            <option value="Sqft">Sqft</option>
                            <option value="SqM">SqM</option>
                            <option value="SqYd">SqYd</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Built-up Area</label>
                        <input asp-for="Property.BuiltUpArea" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Super Built-up</label>
                        <input asp-for="Property.SuperBuiltUpArea" class="form-control" type="number" step="0.01" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pricing -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-currency-rupee me-1 text-warning"></i> Pricing</h6>
                <div class="row g-3">
                    <div class="col-4">
                        <label class="form-label">Base Price (₹)</label>
                        <input asp-for="Property.BasePrice" class="form-control" type="number" step="1000" />
                    </div>
                    <div class="col-4">
                        <label class="form-label">Total Price (₹)</label>
                        <input asp-for="Property.TotalPrice" class="form-control" type="number" step="1000" />
                    </div>
                    <div class="col-4">
                        <label class="form-label">Price/sqft (₹)</label>
                        <input asp-for="Property.PricePerSqft" class="form-control" type="number" step="10" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Location -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt me-1 text-danger"></i> Location</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">City</label>
                        <input asp-for="Property.City" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Location</label>
                        <input asp-for="Property.Location" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Full Address</label>
                        <input asp-for="Property.Address" class="form-control" maxlength="200" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status & Owner -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-toggle-on me-1 text-primary"></i> Status & Owner</h6>
                <div class="row g-3 align-items-end">
                    <div class="col-md-3 col-6">
                        <label class="form-label">Status</label>
                        <select asp-for="Property.Status" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Booked">Booked</option>
                            <option value="Sold">Sold</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Under Construction">Under Construction</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="Property.IsFeatured" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Featured</label>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Owner Name</label>
                        <input asp-for="Property.OwnerName" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Owner Phone</label>
                        <input asp-for="Property.OwnerPhone" class="form-control" maxlength="20" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Property.Notes" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Images -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-images me-1 text-info"></i> Images (<span id="imgCount">@Model.ExistingImages.Count</span>)</h6>

                @if (Model.ExistingImages.Count > 0)
                {
                    <div class="row g-2 mb-3" id="existingImages">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="col-6 col-md-3 col-lg-2 existing-image">
                                <div class="img-tile">
                                    <img src="~/@img.FilePath" loading="lazy" />
                                    <input type="hidden" name="KeepImageIds" value="@img.Id" />
                                    <button type="button" class="img-remove" title="Remove image" aria-label="Remove image">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="bi bi-info-circle me-1"></i>Click &times; on an image to delete it on save.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">No images uploaded yet.</p>
                }

                <label class="form-label small fw-semibold">Upload New Images</label>
                <input type="file" id="imageFiles" name="ImageFiles" class="d-none" accept="image/*" multiple />
                <div id="dropZone" class="drop-zone" role="button" tabindex="0">
                    <i class="bi bi-cloud-arrow-up fs-2 text-primary"></i>
                    <div class="fw-semibold">Click to select or drag &amp; drop images here</div>
                    <div class="small text-muted">You can select multiple images at once</div>
                </div>
                <div class="form-text">
                    <i class="bi bi-info-circle me-1"></i>
                    JPG, PNG, WebP — max 5 MB each.
                </div>

                <div class="row g-2 mt-2" id="newPreviews"></div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="col-12 d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2 me-1"></i>Save Changes
        </button>
    </div>
</form>

<style>
    .img-tile { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: .6rem; background: #f1f3f5; }
    .img-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .img-remove {
        position: absolute; top: .35rem; right: .35rem;
        width: 1.7rem; height: 1.7rem; padding: 0;
        display: flex; align-items: center; justify-content: center;
        border: 0; border-radius: 50%;
        background: rgba(0,0,0,.65); color: #fff; font-size: .7rem;
        transition: background .15s;
    }
    .img-remove:hover { background: #dc3545; }
    .drop-zone {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem;
        padding: 1.5rem 1rem; text-align: center; cursor: pointer;
        border: 2px dashed #ced4da; border-radius: .75rem; background: #f8f9fa;
        transition: border-color .15s, background .15s;
    }
    .drop-zone:hover, .drop-zone.dragover { border-color: #0d6efd; background: #eef4ff; }
    .new-badge {
        position: absolute; bottom: .35rem; left: .35rem;
        padding: .1rem .45rem; border-radius: 1rem; font-size: .65rem; font-weight: 600;
        background: #198754; color: #fff;
    }
</style>

<script>
    (function () {
        var input = document.getElementById('imageFiles');
        var zone = document.getElementById('dropZone');
        var previews = document.getElementById('newPreviews');
        var countEl = document.getElementById('imgCount');
        var files = new DataTransfer();

        function updateCount() {
            var existing = document.querySelectorAll('.existing-image').length;
            countEl.textContent = existing + files.files.length;
        }

        function render() {
            previews.innerHTML = '';
            Array.prototype.forEach.call(files.files, function (f, i) {
                var col = document.createElement('div');
                col.className = 'col-6 col-md-3 col-lg-2';
                var tile = document.createElement('div');
                tile.className = 'img-tile';
                var im = document.createElement('img');
                im.src = URL.createObjectURL(f);
                im.onload = function () { URL.revokeObjectURL(im.src); };
                var rm = document.createElement('button');
                rm.type = 'button';
                rm.className = 'img-remove';
                rm.title = 'Remove image';
                rm.innerHTML = '<i class="bi bi-x-lg"></i>';
                rm.onclick = function () { removeAt(i); };
                var badge = document.createElement('span');
                badge.className = 'new-badge';
                badge.textContent = 'New';
                tile.appendChild(im); tile.appendChild(rm); tile.appendChild(badge);
                col.appendChild(tile);
                previews.appendChild(col);
            });
            input.files = files.files;
            updateCount();
        }

        function addFiles(list) {
            Array.prototype.forEach.call(list, function (f) {
                if (!f.type.startsWith('image/')) return;
                var dup = Array.prototype.some.call(files.files, function (x) {
                    return x.name === f.name && x.size === f.size && x.lastModified === f.lastModified;
                });
                if (!dup) files.items.add(f);
            });
            render();
        }

        function removeAt(index) {
            var next = new DataTransfer();
            Array.prototype.forEach.call(files.files, function (f, i) { if (i !== index) next.items.add(f); });
            files = next;
            render();
        }

        zone.addEventListener('click', function () { input.click(); });
        zone.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
        });
        input.addEventListener('change', function () {
            var picked = Array.prototype.slice.call(input.files);
            addFiles(picked);
        });
        ['dragenter', 'dragover'].forEach(function (ev) {
            zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.add('dragover'); });
        });
        ['dragleave', 'drop'].forEach(function (ev) {
            zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.remove('dragover'); });
        });
        zone.addEventListener('drop', function (e) { addFiles(e.dataTransfer.files); });

        // Remove an existing image: dropping its hidden KeepImageIds input makes the server delete it on save
        document.querySelectorAll('.existing-image .img-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
                btn.closest('.existing-image').remove();
                updateCount();
            });
        });
    })();
</script>
