@{
    Layout = null;
    var brand = AppOpt.Value.BrandName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#04202E" />
    <title>Sign in — @brand</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-split" aria-label="Sign in to @brand">

        <!-- ============ LEFT: cinematic visual ============ -->
        <aside class="login-visual">
            <div class="lv-brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img">
                        <path d="M4 17 9 7l4 6 3-4 4 8" />
                    </svg>
                </span>
                <span>@brand</span>
            </div>

            <div class="lv-copy">
                <h2 class="lv-title">Close more deals, with less busywork.</h2>
                <p class="lv-sub">Leads, site visits, and follow-ups in one calm workspace — built for teams that move fast.</p>
                <ul class="lv-chips" aria-hidden="true">
                    <li><i class="bi bi-funnel"></i> Leads</li>
                    <li><i class="bi bi-geo-alt"></i> Site visits</li>
                    <li><i class="bi bi-briefcase"></i> Deals</li>
                    <li><i class="bi bi-whatsapp"></i> Follow-ups</li>
                </ul>
            </div>
        </aside>

        <!-- ============ RIGHT: sign-in panel ============ -->
        <section class="login-panel">
            <form class="login-card" id="loginCard" method="post" novalidate aria-labelledby="loginTitle">
                <span class="login-eyebrow"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i> Secure sign in</span>
                <h1 class="login-title" id="loginTitle">Welcome back</h1>
                <p class="login-sub">Sign in to manage leads, site visits and deals.</p>

                <div class="field">
                    <label class="form-label" for="username">Username</label>
                    <div class="field-wrap">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input id="username" name="username" class="form-control" placeholder="you@company.com" autocomplete="username" required autofocus />
                    </div>
                </div>

                <div class="field">
                    <label class="form-label" for="pw">Password</label>
                    <div class="field-wrap">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input id="pw" type="password" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required />
                        <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="caps-hint d-none" id="capsHint" role="status">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Caps Lock is on
                    </div>
                </div>

                <button id="loginBtn" type="submit" class="btn login-btn w-100">
                    <span class="label">Sign in <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </form>

            <p class="login-foot">© @DateTime.Now.Year @brand — Crafted for ambitious teams.</p>
        </section>
    </main>

    <div class="toast-stack" id="toastStack"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ============ Animated Earth (connected dots) ============ -->
    <script>
        (() => {
            const canvas = document.getElementById('lvGlobe');
            if (!canvas || !canvas.getContext) return;
            const ctx = canvas.getContext('2d');
            const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // ---- compact 180x90 land bitmap (1 bit per 2° cell) ----
            const MW = 180, MH = 90;
            const MASK = '';
            const raw = atob(MASK);
            const bytes = new Uint8Array(raw.length);
            for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);
            const isLand = (latDeg, lonDeg) => {
                const x = Math.min(MW - 1, Math.max(0, Math.floor((lonDeg + 180) / 360 * MW)));
                const y = Math.min(MH - 1, Math.max(0, Math.floor((90 - latDeg) / 180 * MH)));
                const i = y * MW + x;
                return (bytes[i >> 3] >> (7 - (i & 7))) & 1;
            };

            const RAD = Math.PI / 180, TAU = Math.PI * 2;
            const GA = Math.PI * (3 - Math.sqrt(5));

            // ---- dots spread evenly over a sphere; split into land / sea ----
            let land = [], sea = [];
            const N = 3400;
            for (let i = 0; i < N; i++) {
                const y = 1 - 2 * (i + 0.5) / N;
                const r = Math.sqrt(1 - y * y);
                const lon = ((GA * i + Math.PI) % TAU + TAU) % TAU - Math.PI;
                const p = { x: r * Math.sin(lon), y: y, z: r * Math.cos(lon) };
                (isLand(Math.asin(y) / RAD, lon / RAD) ? land : sea).push(p);
            }
            sea = sea.filter((_, i) => i % 3 === 0);

            // ---- links between neighbouring land dots ----
            const links = [];
            const TH2 = 0.085 * 0.085;
            for (let i = 0; i < land.length; i++) {
                for (let j = i + 1; j < land.length; j++) {
                    const a = land[i], b = land[j];
                    const dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
                    if (dx * dx + dy * dy + dz * dz < TH2 && ((i * 7 + j * 13) % 100) < 62) links.push([i, j]);
                }
            }

            // ---- hubs + great-circle arcs ----
            const vec = (lat, lon) => {
                const f = lat * RAD, l = lon * RAD;
                return { x: Math.cos(f) * Math.sin(l), y: Math.sin(f), z: Math.cos(f) * Math.cos(l) };
            };
            const hubs = [
                vec(19.07, 72.88),   // 0 Mumbai
                vec(28.61, 77.21),   // 1 Delhi
                vec(51.5, -0.12),    // 2 London
                vec(40.71, -74.0),   // 3 New York
                vec(25.2, 55.27),    // 4 Dubai
                vec(1.35, 103.82),   // 5 Singapore
                vec(35.68, 139.69),  // 6 Tokyo
                vec(-33.87, 151.21), // 7 Sydney
                vec(-23.55, -46.63), // 8 Sao Paulo
                vec(-33.92, 18.42),  // 9 Cape Town
                vec(37.77, -122.42)  // 10 San Francisco
            ];
            const PAIRS = [[0, 4], [0, 5], [0, 2], [1, 6], [4, 2], [2, 3], [3, 8], [3, 10], [5, 7], [6, 10], [4, 9], [0, 7]];
            const SEG = 48;
            const arcs = PAIRS.map((pr, k) => {
                const A = hubs[pr[0]], B = hubs[pr[1]];
                const d = Math.min(1, Math.max(-1, A.x * B.x + A.y * B.y + A.z * B.z));
                const om = Math.acos(d), s = Math.sin(om);
                const pts = [];
                for (let i = 0; i <= SEG; i++) {
                    const t = i / SEG;
                    const k1 = Math.sin((1 - t) * om) / s, k2 = Math.sin(t * om) / s;
                    const lift = 1 + 0.38 * (om / Math.PI) * Math.sin(Math.PI * t);
                    pts.push({ x: (k1 * A.x + k2 * B.x) * lift, y: (k1 * A.y + k2 * B.y) * lift, z: (k1 * A.z + k2 * B.z) * lift });
                }
                return { pts, sx: new Float32Array(SEG + 1), sy: new Float32Array(SEG + 1), vis: new Uint8Array(SEG + 1),
                         speed: 0.16 + (k % 4) * 0.035, off: (k * 0.173) % 1 };
            });

            // ---- background stars ----
            const stars = [];
            let seed = 7;
            const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
            for (let i = 0; i < 46; i++) stars.push({ x: rnd(), y: rnd(), r: 0.6 + rnd() * 1.0, ph: rnd() * TAU });

            // ---- per-frame buffers ----
            const lpx = new Float32Array(land.length), lpy = new Float32Array(land.length), lpz = new Float32Array(land.length);
            const spx = new Float32Array(sea.length),  spy = new Float32Array(sea.length),  spz = new Float32Array(sea.length);

            let W = 0, H = 0, dpr = 1;
            function resize() {
                const r = canvas.getBoundingClientRect();
                W = r.width; H = r.height;
                dpr = Math.min(window.devicePixelRatio || 1, 2);
                canvas.width = Math.round(W * dpr);
                canvas.height = Math.round(H * dpr);
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                if (reduce && W && H) draw(0);
            }

            const TH0 = -78 * RAD;          // start with India facing the viewer
            const TILT = 18 * RAD;
            const cT = Math.cos(TILT), sT = Math.sin(TILT);

            function draw(t) {
                ctx.clearRect(0, 0, W, H);
                const cx = W / 2, cy = H / 2;
                const R = Math.min(W, H) * 0.44;
                const th = TH0 + t * 0.16;
                const cth = Math.cos(th), sth = Math.sin(th);

                let rx = 0, ry = 0, rz = 0;
                const P = (x, y, z) => {
                    const x1 = x * cth + z * sth;
                    const z1 = -x * sth + z * cth;
                    rx = x1;
                    ry = y * cT - z1 * sT;
                    rz = y * sT + z1 * cT;
                };

                // stars
                for (let i = 0; i < stars.length; i++) {
                    const s = stars[i];
                    ctx.globalAlpha = 0.14 + 0.28 * (0.5 + 0.5 * Math.sin(t * 0.8 + s.ph));
                    ctx.fillStyle = '#DDEBFF';
                    ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r, 0, TAU); ctx.fill();
                }
                ctx.globalAlpha = 1;

                // atmosphere glow
                let g = ctx.createRadialGradient(cx, cy, R * 0.8, cx, cy, R * 1.7);
                g.addColorStop(0, 'rgba(92,209,255,0.26)');
                g.addColorStop(0.45, 'rgba(47,91,234,0.12)');
                g.addColorStop(1, 'rgba(47,91,234,0)');
                ctx.fillStyle = g;
                ctx.beginPath(); ctx.arc(cx, cy, R * 1.7, 0, TAU); ctx.fill();

                // orbit ring (back half) + satellite when behind
                const ringRx = R * 1.3, ringRy = R * 0.42, ringRot = -0.32;
                const sa = t * 0.45, sSin = Math.sin(sa);
                const satX = cx + ringRx * Math.cos(sa) * Math.cos(ringRot) - ringRy * sSin * Math.sin(ringRot);
                const satY = cy + ringRx * Math.cos(sa) * Math.sin(ringRot) + ringRy * sSin * Math.cos(ringRot);
                const drawSat = () => {
                    ctx.fillStyle = 'rgba(155,229,255,0.28)';
                    ctx.beginPath(); ctx.arc(satX, satY, 7, 0, TAU); ctx.fill();
                    ctx.fillStyle = '#FFFFFF';
                    ctx.beginPath(); ctx.arc(satX, satY, 2.6, 0, TAU); ctx.fill();
                };
                ctx.lineWidth = 1;
                ctx.setLineDash([2, 7]);
                ctx.strokeStyle = 'rgba(155,229,255,0.22)';
                ctx.beginPath(); ctx.ellipse(cx, cy, ringRx, ringRy, ringRot, Math.PI, TAU); ctx.stroke();
                ctx.setLineDash([]);
                if (sSin < 0) drawSat();

                // sphere body
                g = ctx.createRadialGradient(cx - R * 0.35, cy - R * 0.4, R * 0.05, cx, cy, R * 1.05);
                g.addColorStop(0, 'rgba(110,170,255,0.30)');
                g.addColorStop(0.55, 'rgba(30,58,138,0.38)');
                g.addColorStop(1, 'rgba(6,12,40,0.62)');
                ctx.fillStyle = g;
                ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.fill();

                // rim light
                g = ctx.createRadialGradient(cx, cy, R * 0.8, cx, cy, R);
                g.addColorStop(0, 'rgba(92,209,255,0)');
                g.addColorStop(1, 'rgba(92,209,255,0.34)');
                ctx.fillStyle = g;
                ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.fill();
                ctx.strokeStyle = 'rgba(155,229,255,0.38)';
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.arc(cx, cy, R, 0, TAU); ctx.stroke();

                // project dots
                for (let i = 0; i < land.length; i++) {
                    const p = land[i]; P(p.x, p.y, p.z);
                    lpx[i] = cx + R * rx; lpy[i] = cy - R * ry; lpz[i] = rz;
                }
                for (let i = 0; i < sea.length; i++) {
                    const p = sea[i]; P(p.x, p.y, p.z);
                    spx[i] = cx + R * rx; spy[i] = cy - R * ry; spz[i] = rz;
                }

                // sea dots (faint)
                ctx.fillStyle = 'rgba(120,170,255,0.30)';
                ctx.beginPath();
                const sr = Math.max(0.6, R * 0.0045);
                for (let i = 0; i < sea.length; i++) {
                    if (spz[i] <= 0.02) continue;
                    ctx.moveTo(spx[i] + sr, spy[i]); ctx.arc(spx[i], spy[i], sr, 0, TAU);
                }
                ctx.fill();

                // links between land dots (3 depth buckets)
                ctx.lineWidth = 0.6;
                for (let b = 0; b < 3; b++) {
                    ctx.strokeStyle = 'rgba(92,209,255,' + (0.14 + b * 0.16).toFixed(2) + ')';
                    ctx.beginPath();
                    for (let k = 0; k < links.length; k++) {
                        const i = links[k][0], j = links[k][1];
                        const z = (lpz[i] + lpz[j]) * 0.5;
                        if (z <= 0 || Math.min(2, Math.floor(z * 3)) !== b) continue;
                        ctx.moveTo(lpx[i], lpy[i]); ctx.lineTo(lpx[j], lpy[j]);
                    }
                    ctx.stroke();
                }

                // land dots (4 depth buckets)
                for (let b = 0; b < 4; b++) {
                    ctx.fillStyle = 'rgba(155,229,255,' + (0.35 + b * 0.22).toFixed(2) + ')';
                    const dr = Math.max(0.8, R * (0.0058 + b * 0.0016));
                    ctx.beginPath();
                    for (let i = 0; i < land.length; i++) {
                        const z = lpz[i];
                        if (z <= 0 || Math.min(3, Math.floor(z * 4)) !== b) continue;
                        ctx.moveTo(lpx[i] + dr, lpy[i]); ctx.arc(lpx[i], lpy[i], dr, 0, TAU);
                    }
                    ctx.fill();
                }

                // arcs + travelling pulses
                for (let a = 0; a < arcs.length; a++) {
                    const arc = arcs[a], pts = arc.pts;
                    for (let i = 0; i <= SEG; i++) {
                        const p = pts[i]; P(p.x, p.y, p.z);
                        arc.sx[i] = cx + R * rx; arc.sy[i] = cy - R * ry;
                        arc.vis[i] = (rz > 0 || rx * rx + ry * ry > 1) ? 1 : 0;
                    }
                    ctx.strokeStyle = 'rgba(92,209,255,0.30)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    for (let i = 0; i < SEG; i++) {
                        if (arc.vis[i] && arc.vis[i + 1]) { ctx.moveTo(arc.sx[i], arc.sy[i]); ctx.lineTo(arc.sx[i + 1], arc.sy[i + 1]); }
                    }
                    ctx.stroke();

                    const head = ((t * arc.speed + arc.off) % 1) * SEG;
                    const hi = Math.floor(head);
                    ctx.lineCap = 'round';
                    for (let k = 0; k < 12; k++) {
                        const i = hi - k;
                        if (i < 0 || i >= SEG || !arc.vis[i] || !arc.vis[i + 1]) continue;
                        ctx.strokeStyle = 'rgba(230,248,255,' + (0.9 * (1 - k / 12)).toFixed(2) + ')';
                        ctx.lineWidth = 1.8 - k * 0.07;
                        ctx.beginPath(); ctx.moveTo(arc.sx[i], arc.sy[i]); ctx.lineTo(arc.sx[i + 1], arc.sy[i + 1]); ctx.stroke();
                    }
                    ctx.lineCap = 'butt';
                    if (hi < SEG && arc.vis[hi]) {
                        ctx.fillStyle = 'rgba(155,229,255,0.30)';
                        ctx.beginPath(); ctx.arc(arc.sx[hi], arc.sy[hi], 5.5, 0, TAU); ctx.fill();
                        ctx.fillStyle = '#FFFFFF';
                        ctx.beginPath(); ctx.arc(arc.sx[hi], arc.sy[hi], 2.1, 0, TAU); ctx.fill();
                    }
                }

                // hubs with ping rings
                for (let h = 0; h < hubs.length; h++) {
                    const p = hubs[h]; P(p.x, p.y, p.z);
                    if (rz <= 0.02) continue;
                    const x = cx + R * rx, y = cy - R * ry;
                    const ph = (t * 0.55 + h * 0.37) % 1;
                    ctx.strokeStyle = 'rgba(230,194,122,' + (0.6 * (1 - ph)).toFixed(2) + ')';
                    ctx.lineWidth = 1.2;
                    ctx.beginPath(); ctx.arc(x, y, 3 + ph * 14, 0, TAU); ctx.stroke();
                    ctx.fillStyle = '#E6C27A';
                    ctx.beginPath(); ctx.arc(x, y, 3.2, 0, TAU); ctx.fill();
                    ctx.fillStyle = '#FFFFFF';
                    ctx.beginPath(); ctx.arc(x, y, 1.3, 0, TAU); ctx.fill();
                }

                // orbit ring (front half) + satellite when in front
                ctx.setLineDash([2, 7]);
                ctx.strokeStyle = 'rgba(155,229,255,0.5)';
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.ellipse(cx, cy, ringRx, ringRy, ringRot, 0, Math.PI); ctx.stroke();
                ctx.setLineDash([]);
                if (sSin >= 0) drawSat();
            }

            if ('ResizeObserver' in window) new ResizeObserver(resize).observe(canvas);
            else window.addEventListener('resize', resize);
            resize();

            if (!reduce) {
                const start = performance.now();
                const loop = (now) => {
                    requestAnimationFrame(loop);
                    if (W && H) draw((now - start) / 1000);
                };
                requestAnimationFrame(loop);
            }
        })();
    </script>

    <script>
        (() => {
            const form = document.getElementById('loginCard'),
                  btn  = document.getElementById('loginBtn'),
                  pw   = document.getElementById('pw'),
                  toggle = document.getElementById('pwToggle'),
                  caps = document.getElementById('capsHint'),
                  stack = document.getElementById('toastStack');

            function toast(msg, type) {
                const el = document.createElement('div');
                el.className = `toast align-items-center text-bg-${type} border-0`;
                el.innerHTML = '<div class="d-flex"><div class="toast-body"></div>' +
                               '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>';
                el.querySelector('.toast-body').textContent = msg;
                stack.appendChild(el);
                el.addEventListener('hidden.bs.toast', () => el.remove());
                new bootstrap.Toast(el, { delay: 3500 }).show();
            }

            function busy(on) {
                btn.disabled = on;
                btn.querySelector('.label').classList.toggle('d-none', on);
                btn.querySelector('.spinner-border').classList.toggle('d-none', !on);
            }

            // Caps Lock hint (UI only)
            const capsCheck = (e) => {
                const on = e.getModifierState && e.getModifierState('CapsLock');
                caps.classList.toggle('d-none', !on);
            };
            pw.addEventListener('keydown', capsCheck);
            pw.addEventListener('keyup', capsCheck);
            pw.addEventListener('blur', () => caps.classList.add('d-none'));

            toggle.addEventListener('click', () => {
                const show = pw.type === 'password';
                pw.type = show ? 'text' : 'password';
                toggle.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
                toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                pw.focus();
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!form.checkValidity()) {
                    toast('Enter your username and password.', 'warning');
                    return;
                }
                busy(true);
                try {
                    const res = await fetch(form.getAttribute('action') || location.pathname, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: new FormData(form)
                    });
                    const data = await res.json();
                    if (data.success) {
                        toast('Signed in. Redirecting…', 'success');
                        setTimeout(() => location.href = data.redirectUrl, 650);
                    } else {
                        toast(data.message || 'Invalid credentials.', 'danger');
                        form.classList.add('shake');
                        setTimeout(() => form.classList.remove('shake'), 500);
                        busy(false);
                    }
                } catch {
                    toast('Something went wrong. Please try again.', 'danger');
                    busy(false);
                }
            });
        })();
    </script>
</body>
</html>