@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sign in - @AppOpt.Value.BrandName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>

    <main class="login-card" id="loginCard">
        <div class="login-logo"><i class="bi bi-buildings-fill"></i></div>
        <h1 class="login-title">@AppOpt.Value.BrandName</h1>
        <p class="login-sub">Sign in to manage leads, site visits and deals.</p>

        <form id="loginForm" method="post" novalidate>
            <div class="field">
                <i class="bi bi-person"></i>
                <input name="username" class="form-control" placeholder="Username" autocomplete="username" required autofocus />
            </div>
            <div class="field">
                <i class="bi bi-lock"></i>
                <input id="pw" type="password" name="password" class="form-control" placeholder="Password" autocomplete="current-password" required />
                <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <button id="loginBtn" type="submit" class="btn login-btn w-100">
                <span class="label">Sign in</span><span class="spinner-border spinner-border-sm d-none"></span>
            </button>
        </form>
    </main>

    <div class="toast-stack" id="toastStack"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById('loginForm'), btn = document.getElementById('loginBtn'),
              card = document.getElementById('loginCard'), stack = document.getElementById('toastStack');

        function toast(msg, type) {
            const el = document.createElement('div');
            el.className = `toast align-items-center text-bg-${type} border-0`;
            el.innerHTML = '<div class="d-flex"><div class="toast-body"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            el.querySelector('.toast-body').textContent = msg;
            stack.appendChild(el);
            el.addEventListener('hidden.bs.toast', () => el.remove());
            new bootstrap.Toast(el, { delay: 3500 }).show();
        }
        function busy(on) {
            btn.disabled = on;
            btn.querySelector('.label').classList.toggle('d-none', on);
            btn.querySelector('.spinner-border').classList.toggle('d-none', !on);
        }

        document.getElementById('pwToggle').addEventListener('click', () => {
            const pw = document.getElementById('pw'), show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            document.querySelector('#pwToggle i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        form.addEventListener('submit', async e => {
            e.preventDefault();
            if (!form.checkValidity()) { toast('Enter your username and password.', 'warning'); return; }
            busy(true);
            try {
                const res = await fetch(form.getAttribute('action') || location.pathname, {
                    method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form)
                });
                const data = await res.json();
                if (data.success) {
                    toast('Signed in. Redirecting…', 'success');
                    setTimeout(() => location.href = data.redirectUrl, 700);
                } else {
                    toast(data.message, 'danger');
                    card.classList.add('shake'); setTimeout(() => card.classList.remove('shake'), 500);
                    busy(false);
                }
            } catch { toast('Something went wrong. Please try again.', 'danger'); busy(false); }
        });
    </script>
</body>
</html>