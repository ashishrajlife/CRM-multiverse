<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppOpt.Value.BrandName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ===== Layout shell ===== */
        html, body {
            height: 100%;
            margin: 0;
        }

        .app-shell {
            display: flex;
            height: 100vh;
            overflow: hidden; /* page scroll happens inside columns */
        }

        /* ===== Sidebar ===== */
        .sidebar {
            display: flex;
            flex-direction: column;
            width: 250px;
            flex-shrink: 0;
            height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e5e7eb;
        }

        /* Brand header (pinned) */
        .sidebar .brand-logo {
            flex-shrink: 0;
            padding: 1.25rem 1rem;
            font-weight: 700;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: .5rem;
            border-bottom: 1px solid #e5e7eb;
            color: #111827;
        }
        .sidebar .brand-logo i {
            color: #4f46e5;
        }

        /* Scrollable nav */
        .sidebar-nav {
            flex: 1 1 auto;
            min-height: 0;              /* critical: lets flex child shrink & scroll */
            overflow-y: auto;
            overflow-x: hidden;
            padding: .75rem .5rem;
            margin: 0;
        }

        /* Slim scrollbar */
        .sidebar-nav::-webkit-scrollbar { width: 6px; }
        .sidebar-nav::-webkit-scrollbar-track { background: transparent; }
        .sidebar-nav::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, .45);
            border-radius: 3px;
        }
        .sidebar-nav::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, .75);
        }
        .sidebar-nav {
            scrollbar-width: thin;
            scrollbar-color: rgba(148,163,184,.45) transparent;
        }

        /* Nav links */
        .sidebar-nav .nav-link {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .55rem .75rem;
            border-radius: 8px;
            color: #475569;
            font-size: .9rem;
            font-weight: 500;
            white-space: nowrap;
        }
        .sidebar-nav .nav-link i {
            font-size: 1rem;
            width: 1.1rem;
            text-align: center;
        }
        .sidebar-nav .nav-link:hover {
            background: #f1f5f9;
            color: #1e293b;
        }
        .sidebar-nav .nav-link.active {
            background: #eef2ff;
            color: #4f46e5;
        }
        .sidebar-nav .nav-link.nav-soon {
            cursor: default;
            opacity: .7;
        }
        .sidebar-nav .nav-link.nav-soon em {
            font-style: normal;
            font-size: .65rem;
            background: #e2e8f0;
            color: #64748b;
            padding: 1px 6px;
            border-radius: 999px;
            margin-left: auto;
        }

        /* Footer (pinned Sign Out) */
        .sidebar-footer {
            flex-shrink: 0;
            padding: 1rem;
            border-top: 1px solid #e5e7eb;
            background: #ffffff;
        }

        /* ===== Main column ===== */
        .main-col {
            flex-grow: 1;
            min-width: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-header {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.5rem;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
        }

        .page-content {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            padding: 1.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            padding: .25rem .5rem;
            color: #334155;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            flex-shrink: 0;
        }

        /* ===== Mobile ===== */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .45);
            z-index: 1040;
        }
        .sidebar-backdrop.show {
            display: block;
        }

        @@media (max-width: 991.98px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                height: 100dvh;
                z-index: 1050;
                transform: translateX(-100%);
                transition: transform .25s ease;
                box-shadow: 0 0 24px rgba(15, 23, 42, .15);
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .mobile-menu-btn {
                display: inline-flex;
            }
            .app-shell {
                height: 100dvh;
            }
            .main-col {
                height: 100dvh;
            }
        }
    </style>
</head>
<body>
    <div class="app-shell">

        <!-- Sidebar Backdrop (mobile) -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Sidebar -->
        <div class="sidebar" id="appSidebar">
            <div class="brand-logo">
                <i class="bi bi-box-seam-fill"></i> Multiverse CRM
            </div>

            <ul class="nav flex-column sidebar-nav">
                @{
                    var cc = ViewContext.RouteData.Values["controller"]?.ToString();
                    var nav = new (string? Ctrl, string Icon, string Label)[] {
                        ("Dashboard", "bi-grid-1x2", "Dashboard"), ("Leads", "bi-funnel", "Leads"),
                        (null, "bi-briefcase", "Deals"), (null, "bi-x-circle", "Lost Leads"),
                        (null, "bi-folder2-open", "Projects"), (null, "bi-whatsapp", "Whatsapp"),
                        (null, "bi-journal-text", "Contact Book"), (null, "bi-bar-chart-line", "Reports")
                    };
                }
                @foreach (var n in nav)
                {
                    if (n.Ctrl != null)
                    {
                        <li class="nav-item">
                            <a asp-controller="@n.Ctrl" asp-action="Index" title="@n.Label"
                               class="nav-link @(cc == n.Ctrl ? "active" : "")"><i class="bi @n.Icon"></i> @n.Label</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link nav-soon" title="@n.Label"><i class="bi @n.Icon"></i> @n.Label <em>Soon</em></span>
                        </li>
                    }
                }
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-sm w-100" style="border-radius: 8px;">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-col">
            <!-- Top Header -->
            <div class="top-header">
                <div class="d-flex align-items-center gap-2">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block">
                        <div class="fw-semibold" style="font-size: 0.9rem;">@User.FindFirst("FullName")?.Value</div>
                        <div class="text-muted" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    </div>
                    <div class="avatar">
                        @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                    </div>
                </div>
            </div>

            <!-- Page Content (scrolls independently) -->
            <div class="page-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script>
        // Mobile sidebar toggle
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('mobileMenuBtn');
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');

            btn?.addEventListener('click', function () {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            });
            backdrop?.addEventListener('click', function () {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            });
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>