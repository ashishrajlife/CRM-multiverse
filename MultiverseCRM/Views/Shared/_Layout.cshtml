@{
    var cc = ViewContext.RouteData.Values["controller"]?.ToString();
    var nav = new (string? Ctrl, string Icon, string Label)[] {
        ("Dashboard", "bi-grid-1x2",     "Dashboard"),
        ("Leads",     "bi-funnel",       "Leads"),
        (null,        "bi-briefcase",    "Deals"),
        (null,        "bi-x-circle",     "Lost Leads"),
        (null,        "bi-folder2-open", "Projects"),
        (null,        "bi-whatsapp",     "Whatsapp"),
        (null,        "bi-journal-text", "Contact Book"),
        (null,        "bi-bar-chart-line","Reports")
    };
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#E6F8FF" id="metaThemeColor" />
    <title>@ViewData["Title"] - @AppOpt.Value.BrandName</title>

   <!-- Theme bootstrap: runs before CSS paints, no flash. Robust against storage blocks. -->
<script>
    (function () {
        var theme = 'light';
        try {
            var saved = localStorage.getItem('mv-theme');
            if (saved === 'dark' || saved === 'light') {
                theme = saved;
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                theme = 'dark';
            }
        } catch (e) {
            // localStorage blocked — still check system pref
            try {
                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (_) {}
        }
        document.documentElement.setAttribute('data-theme', theme);
    })();
</script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Layout-only helpers. All visual styling lives in site.css. */
        .top-header .header-actions { gap: .5rem; }
        .icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            padding: 0;
            border-radius: .85rem;
            color: var(--ink);
            background: rgba(255,255,255,.55);
            border: 1px solid var(--glass-border);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            transition: background .2s var(--ease), transform .15s var(--ease), box-shadow .2s var(--ease), color .2s var(--ease);
            position: relative;
        }
        .icon-btn:hover {
            background: rgba(255,255,255,.85);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px -12px rgba(10,122,166,.6);
        }
        .icon-btn:active { transform: translateY(0); }
        .icon-btn i { font-size: 1.1rem; line-height: 1; }
        .icon-btn .theme-icon { transition: transform .5s var(--ease), opacity .3s var(--ease); }
        .icon-btn:hover .theme-icon { transform: rotate(25deg); }

        /* Bell dot (future unread indicator placeholder) */
        .icon-btn .dot {
            display: none;
            position: absolute;
            top: 6px; right: 6px;
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #FF5A5F;
            box-shadow: 0 0 0 2px rgba(255,255,255,.9);
        }
        .icon-btn .dot.show { display: block; animation: dotPulse 1.8s ease-in-out infinite; }
        @@keyframes dotPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50%      { transform: scale(1.3); opacity: .6; }
        }

        /* ===== DARK MODE — layout-specific tweaks ===== */
        [data-theme="dark"] .icon-btn {
            background: rgba(255,255,255,.06);
            color: var(--ink);
            border-color: rgba(255,255,255,.12);
        }
        [data-theme="dark"] .icon-btn:hover {
            background: rgba(92,209,255,.16);
            border-color: rgba(92,209,255,.35);
            box-shadow: 0 10px 26px -12px rgba(92,209,255,.7);
        }
        [data-theme="dark"] .icon-btn .dot { box-shadow: 0 0 0 2px #0B1420; }
    </style>
</head>
<body>
    <div class="app-shell">

        <!-- Sidebar backdrop (mobile) -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Sidebar -->
        <aside class="sidebar" id="appSidebar">
            <div class="brand-logo">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 17 9 7l4 6 3-4 4 8" /></svg>
                </span>
                <span class="brand-text">@AppOpt.Value.BrandName</span>
            </div>

            <ul class="nav flex-column sidebar-nav">
                @foreach (var n in nav)
                {
                    if (n.Ctrl != null)
                    {
                        <li class="nav-item">
                            <a asp-controller="@n.Ctrl" asp-action="Index" title="@n.Label"
                               class="nav-link @(cc == n.Ctrl ? "active" : "")">
                                <i class="bi @n.Icon"></i><span>@n.Label</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link nav-soon" title="@n.Label">
                                <i class="bi @n.Icon"></i><span>@n.Label</span><em>Soon</em>
                            </span>
                        </li>
                    }
                }
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout"
                   class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-lg-inline">Sign Out</span>
                    <i class="bi bi-box-arrow-right d-lg-none"></i>
                </a>
            </div>
        </aside>

        <!-- Main column -->
        <div class="main-col">
            <header class="top-header">
                <div class="d-flex align-items-center gap-2">
                    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center header-actions">
                    <!-- Night mode toggle -->
                    <button class="icon-btn" id="themeToggle" type="button"
                            aria-label="Toggle dark mode" title="Toggle dark mode">
                        <i class="bi bi-moon-stars theme-icon" id="themeIcon"></i>
                    </button>

                    <!-- Bell (placeholder — click does nothing yet) -->
                    <button class="icon-btn" id="bellBtn" type="button"
                            aria-label="Notifications" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="dot" id="bellDot"></span>
                    </button>

                    <!-- Profile -->
                    <div class="text-end d-none d-sm-block ms-1">
                        <div class="fw-semibold" style="font-size:.9rem;color:var(--ink);">
                            @User.FindFirst("FullName")?.Value
                        </div>
                        <div style="font-size:.75rem;color:var(--ink-soft);">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </div>
                    </div>
                    <div class="avatar">
                        @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                    </div>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
    (function () {
        'use strict';

        function ready(fn) {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fn);
            } else {
                fn();
            }
        }

        ready(function () {
            var root = document.documentElement;

            // ---------- Safe storage helpers ----------
            function getStored(key) {
                try { return localStorage.getItem(key); } catch (e) { return null; }
            }
            function setStored(key, val) {
                try { localStorage.setItem(key, val); } catch (e) {}
            }

            // ---------- Mobile sidebar ----------
            var menuBtn  = document.getElementById('mobileMenuBtn');
            var sidebar  = document.getElementById('appSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');

            function closeSidebar() {
                if (sidebar)  sidebar.classList.remove('show');
                if (backdrop) backdrop.classList.remove('show');
            }
            if (menuBtn) {
                menuBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                });
            }
            if (backdrop) backdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // ---------- Theme toggle ----------
            var toggle = document.getElementById('themeToggle');
            var icon   = document.getElementById('themeIcon');
            var meta   = document.getElementById('metaThemeColor');

            function applyTheme(theme, persist) {
                theme = (theme === 'dark') ? 'dark' : 'light';
                var isDark = theme === 'dark';

                root.setAttribute('data-theme', theme);

                if (icon) {
                    icon.className = isDark
                        ? 'bi bi-brightness-high theme-icon'
                        : 'bi bi-moon-stars theme-icon';
                }
                if (toggle) {
                    toggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
                    toggle.setAttribute('aria-label',  isDark ? 'Switch to light mode' : 'Switch to dark mode');
                    toggle.setAttribute('title',       isDark ? 'Light mode' : 'Dark mode');
                }
                if (meta) {
                    meta.setAttribute('content', isDark ? '#0B1420' : '#E6F8FF');
                }
                if (persist) {
                    setStored('mv-theme', theme);
                }

                // Notify other listeners (e.g. charts that need to redraw)
                try {
                    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } }));
                } catch (e) {}
            }

            // Sync UI with whatever the head-bootstrap decided
            applyTheme(root.getAttribute('data-theme') || 'light', false);

            if (toggle) {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    var current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark', true);
                });
            }

            // Follow system changes only if user hasn't explicitly chosen
            try {
                var mq = window.matchMedia('(prefers-color-scheme: dark)');
                var handler = function (e) {
                    if (!getStored('mv-theme')) {
                        applyTheme(e.matches ? 'dark' : 'light', false);
                    }
                };
                if (mq.addEventListener) mq.addEventListener('change', handler);
                else if (mq.addListener) mq.addListener(handler);
            } catch (e) {}

            // ---------- Bell (placeholder) ----------
            var bellBtn = document.getElementById('bellBtn');
            if (bellBtn) {
                bellBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    // TODO: open notifications panel
                });
            }
            window.setBellUnread = function (on) {
                var dot = document.getElementById('bellDot');
                if (dot) dot.classList.toggle('show', !!on);
            };

            // Expose for debugging / other views
            window.mvTheme = {
                set: applyTheme,
                get: function () { return root.getAttribute('data-theme'); }
            };
        });
    })();
</script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>