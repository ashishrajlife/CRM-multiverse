@{
    var cc = ViewContext.RouteData.Values["controller"]?.ToString();
    var nav = new (string? Ctrl, string Icon, string Label)[] {
        ("Dashboard", "bi-grid-1x2",     "Dashboard"),
        ("Leads",     "bi-funnel",       "Leads"),
        ("Deals",        "bi-briefcase",    "Deals"),
        (null,        "bi-x-circle",     "Lost Leads"),
        (null,        "bi-folder2-open", "Projects"),
        (null,        "bi-whatsapp",     "Whatsapp"),
        (null,        "bi-journal-text", "Contact Book"),
        (null,        "bi-bar-chart-line","Reports")
    };
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#E6F8FF" id="metaThemeColor" />
    <title>@ViewData["Title"] - @AppOpt.Value.BrandName</title>

    <script>
        (function () {
            var theme = 'light';
            try {
                var saved = localStorage.getItem('mv-theme');
                if (saved === 'dark' || saved === 'light') { theme = saved; }
                else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (e) {
                try {
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        theme = 'dark';
                    }
                } catch (_) {}
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .top-header .header-actions { gap: .5rem; }
        .icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            padding: 0;
            border-radius: .85rem;
            color: var(--ink);
            background: rgba(255,255,255,.55);
            border: 1px solid var(--glass-border);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            transition: background .2s var(--ease), transform .15s var(--ease), box-shadow .2s var(--ease), color .2s var(--ease);
            position: relative;
        }
        .icon-btn:hover {
            background: rgba(255,255,255,.85);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px -12px rgba(10,122,166,.6);
        }
        .icon-btn:active { transform: translateY(0); }
        .icon-btn i { font-size: 1.1rem; line-height: 1; }
        .icon-btn .theme-icon { transition: transform .5s var(--ease), opacity .3s var(--ease); }
        .icon-btn:hover .theme-icon { transform: rotate(25deg); }

        [data-theme="dark"] .icon-btn {
            background: rgba(255,255,255,.06);
            color: var(--ink);
            border-color: rgba(255,255,255,.12);
        }
        [data-theme="dark"] .icon-btn:hover {
            background: rgba(92,209,255,.16);
            border-color: rgba(92,209,255,.35);
            box-shadow: 0 10px 26px -12px rgba(92,209,255,.7);
        }
    </style>
</head>
<body>
    <div class="app-shell">

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="sidebar" id="appSidebar">
            <div class="brand-logo">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 17 9 7l4 6 3-4 4 8" /></svg>
                </span>
                <span class="brand-text">@AppOpt.Value.BrandName</span>
            </div>

            <ul class="nav flex-column sidebar-nav">
                @foreach (var n in nav)
                {
                    if (n.Ctrl != null)
                    {
                        <li class="nav-item">
                            <a asp-controller="@n.Ctrl" asp-action="Index" title="@n.Label"
                               class="nav-link @(cc == n.Ctrl ? "active" : "")">
                                <i class="bi @n.Icon"></i><span>@n.Label</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link nav-soon" title="@n.Label">
                                <i class="bi @n.Icon"></i><span>@n.Label</span><em>Soon</em>
                            </span>
                        </li>
                    }
                }
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Logout"
                   class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-lg-inline">Sign Out</span>
                    <i class="bi bi-box-arrow-right d-lg-none"></i>
                </a>
            </div>
        </aside>

        <div class="main-col">
            <header class="top-header">
                <div class="d-flex align-items-center gap-2">
                    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center header-actions">
                    <button class="icon-btn" id="themeToggle" type="button"
                            aria-label="Toggle dark mode" title="Toggle dark mode">
                        <i class="bi bi-moon-stars theme-icon" id="themeIcon"></i>
                    </button>

                    <button class="icon-btn" id="bellBtn" type="button"
                            aria-expanded="false" aria-haspopup="true"
                            aria-label="Notifications" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="badge-count" id="bellDot" hidden>0</span>
                    </button>

                    <div class="text-end d-none d-sm-block ms-1">
                        <div class="fw-semibold" style="font-size:.9rem;color:var(--ink);">
                            @User.FindFirst("FullName")?.Value
                        </div>
                        <div style="font-size:.75rem;color:var(--ink-soft);">
                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        </div>
                    </div>
                    <div class="avatar">
                        @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                    </div>
                </div>
            </header>

            <!-- Notification popover lives OUTSIDE .top-header so backdrop-filter can't clip it -->
            <div class="notification-popover" id="notifPopover" hidden>
                <div class="notification-menu" id="notifMenu" role="dialog" aria-label="Notifications">
                    <div class="notif-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bell-fill"></i>
                            <strong>Notifications</strong>
                            <span class="notif-unread-pill" id="notifUnreadPill" hidden>0 new</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none notif-mark-all" id="notifMarkAll">
                            Mark all read
                        </button>
                    </div>

                    <div class="notif-list" id="notifList" aria-live="polite">
                        <div class="notif-empty">
                            <i class="bi bi-bell-slash"></i>
                            <span>You're all caught up</span>
                        </div>
                    </div>

                    <div class="notif-footer">
                        <span class="text-muted small" id="notifFooterText">No recent activity</span>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none" id="notifRefresh">
                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                        </button>
                    </div>
                </div>
            </div>

            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
    // =========================================================
    // 1. Shell (sidebar + theme)
    // =========================================================
    (function () {
        'use strict';

        function ready(fn) {
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
            else fn();
        }

        ready(function () {
            var root = document.documentElement;

            function getStored(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
            function setStored(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

            // Sidebar
            var menuBtn  = document.getElementById('mobileMenuBtn');
            var sidebar  = document.getElementById('appSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');

            function closeSidebar() {
                if (sidebar)  sidebar.classList.remove('show');
                if (backdrop) backdrop.classList.remove('show');
            }
            if (menuBtn) {
                menuBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (sidebar)  sidebar.classList.toggle('show');
                    if (backdrop) backdrop.classList.toggle('show');
                });
            }
            if (backdrop) backdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Theme
            var toggle = document.getElementById('themeToggle');
            var icon   = document.getElementById('themeIcon');
            var meta   = document.getElementById('metaThemeColor');

            function applyTheme(theme, persist) {
                theme = (theme === 'dark') ? 'dark' : 'light';
                var isDark = theme === 'dark';

                root.setAttribute('data-theme', theme);

                if (icon) {
                    icon.className = isDark
                        ? 'bi bi-brightness-high theme-icon'
                        : 'bi bi-moon-stars theme-icon';
                }
                if (toggle) {
                    toggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
                    toggle.setAttribute('aria-label',  isDark ? 'Switch to light mode' : 'Switch to dark mode');
                    toggle.setAttribute('title',       isDark ? 'Light mode' : 'Dark mode');
                }
                if (meta) meta.setAttribute('content', isDark ? '#0B1420' : '#E6F8FF');
                if (persist) setStored('mv-theme', theme);

                try { window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } })); } catch (e) {}
            }

            applyTheme(root.getAttribute('data-theme') || 'light', false);

            if (toggle) {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    var current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark', true);
                });
            }

            try {
                var mq = window.matchMedia('(prefers-color-scheme: dark)');
                var handler = function (e) {
                    if (!getStored('mv-theme')) applyTheme(e.matches ? 'dark' : 'light', false);
                };
                if (mq.addEventListener) mq.addEventListener('change', handler);
                else if (mq.addListener) mq.addListener(handler);
            } catch (e) {}

            window.mvTheme = {
                set: applyTheme,
                get: function () { return root.getAttribute('data-theme'); }
            };
        });
    })();

    // =========================================================
    // 2. Notifications
    // =========================================================
    (function initNotifications() {
        'use strict';

        function ready(fn) {
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
            else fn();
        }

        ready(function () {
            const bell     = document.getElementById('bellBtn');
            const badge    = document.getElementById('bellDot');
            const pill     = document.getElementById('notifUnreadPill');
            const list     = document.getElementById('notifList');
            const menu     = document.getElementById('notifMenu');
            const popover  = document.getElementById('notifPopover');
            const markAll  = document.getElementById('notifMarkAll');
            const refresh  = document.getElementById('notifRefresh');
            const footer   = document.getElementById('notifFooterText');

            if (!bell || !menu || !list || !popover) {
                console.warn('[notif] required DOM nodes missing');
                return;
            }

            const csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            let lastKnownId = 0;
            let isOpen = false;

            function setUnread(n) {
                if (badge) {
                    badge.textContent = n > 99 ? '99+' : String(n);
                    badge.hidden = n === 0;
                }
                if (pill) {
                    pill.textContent = n > 99 ? '99+ new' : `${n} new`;
                    pill.hidden = n === 0;
                }
                if (markAll) markAll.disabled = n === 0;
                menu.classList.toggle('has-unread', n > 0);
            }

            function iconFor(action) {
                switch (action) {
                    case 'Created':     return { cls: 'success', bi: 'bi-plus-lg' };
                    case 'Updated':     return { cls: 'info',    bi: 'bi-pencil' };
                    case 'Deleted':     return { cls: 'danger',  bi: 'bi-trash' };
                    case 'BulkDeleted': return { cls: 'danger',  bi: 'bi-trash-fill' };
                    case 'Imported':    return { cls: 'info',    bi: 'bi-upload' };
                    case 'TagUpdated':  return { cls: 'warning', bi: 'bi-tags' };
                    default:            return { cls: 'info',    bi: 'bi-dot' };
                }
            }

            function escapeHtml(s) {
                if (s == null) return '';
                return String(s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function render(data) {
                setUnread(data.unreadCount || 0);
                if (data.items.length) lastKnownId = data.items[0].id;

                if (!data.items.length) {
                    list.innerHTML = `
                        <div class="notif-empty">
                            <i class="bi bi-bell-slash"></i>
                            <span>You're all caught up</span>
                        </div>`;
                    if (footer) footer.textContent = 'No recent activity';
                    return;
                }

                list.innerHTML = data.items.map(it => {
                    const { cls, bi } = iconFor(it.action);
                    const unread = it.id > (data.lastReadId || 0);
                    const actionText = it.action.replace(/([A-Z])/g, ' $1').trim();
                    return `
                        <a class="notif-item ${unread ? 'is-unread' : ''}"
                           href="${escapeHtml(it.url || '#')}"
                           data-id="${it.id}">
                            <span class="notif-ico ${cls}"><i class="bi ${bi}"></i></span>
                            <div class="notif-body">
                                <p class="notif-title">${escapeHtml(it.title)}</p>
                                <p class="notif-detail">${escapeHtml(actionText)}${it.detail ? ' · ' + escapeHtml(it.detail) : ''}</p>
                                <p class="notif-meta"><strong>${escapeHtml(it.actor)}</strong> · ${escapeHtml(it.age)}</p>
                            </div>
                        </a>`;
                }).join('');

                if (footer) {
                    footer.textContent = `${data.items.length} recent event${data.items.length === 1 ? '' : 's'}`;
                }
            }

            async function load(silent = false) {
                try {
                    const res = await fetch('/Notifications/Recent?take=15', {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    render(data);
                } catch (_) {
                    if (!silent) {
                        list.innerHTML = '<div class="notif-empty">Could not load notifications</div>';
                    }
                }
            }

            function positionPopover() {
                const rect = bell.getBoundingClientRect();
                popover.style.top   = (rect.bottom + 8) + 'px';
                popover.style.right = (window.innerWidth - rect.right) + 'px';
                popover.style.left  = 'auto';
            }

            function openMenu() {
                isOpen = true;
                bell.setAttribute('aria-expanded', 'true');
                positionPopover();
                popover.hidden = false;
                requestAnimationFrame(() => popover.classList.add('show'));
            }

            function closeMenu() {
                isOpen = false;
                bell.setAttribute('aria-expanded', 'false');
                popover.classList.remove('show');
                setTimeout(() => { popover.hidden = true; }, 200);
            }

            bell.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (isOpen) { closeMenu(); return; }
                openMenu();
                load();
            });

            document.addEventListener('click', (e) => {
                if (!isOpen) return;
                if (popover.contains(e.target) || bell.contains(e.target)) return;
                closeMenu();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && isOpen) closeMenu();
            });

            list.addEventListener('click', (e) => {
                const item = e.target.closest('.notif-item');
                if (!item) return;
                markAll?.click();
                closeMenu();
            });

            window.addEventListener('resize', () => {
                if (isOpen) positionPopover();
            });

            markAll?.addEventListener('click', async (e) => {
                e.preventDefault();
                try {
                    const res = await fetch('/Notifications/MarkAllRead', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': csrf,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    if (!res.ok) return;
                    list.querySelectorAll('.notif-item.is-unread').forEach(el => el.classList.remove('is-unread'));
                    setUnread(0);
                } catch (_) {}
            });

            refresh?.addEventListener('click', (e) => {
                e.preventDefault();
                load();
            });

            // Initial load
            load();

            // Poll every 30 s
            setInterval(async () => {
                if (document.hidden) return;
                try {
                    const res = await fetch(`/Notifications/Poll?since=${lastKnownId}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.hasNew) {
                        bell.classList.add('vibrate');
                        setTimeout(() => bell.classList.remove('vibrate'), 1000);
                        await load(true);
                        const res2 = await fetch('/Notifications/Recent?take=1');
                        if (res2.ok) {
                            const d2 = await res2.json();
                            setUnread(d2.unreadCount || 0);
                        }
                    }
                } catch (_) {}
            }, 30000);

            window.setBellUnread = function (on) {
                setUnread(typeof on === 'number' ? on : (on ? 1 : 0));
            };
        });
    })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>