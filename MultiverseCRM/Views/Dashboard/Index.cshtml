@{
    ViewData["Title"] = "Dashboard";
    var app = AppOpt.Value;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
    var statuses = (List<LookupOption>)ViewBag.Statuses;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int total = ViewBag.Total, unassigned = ViewBag.Unassigned, newWeek = ViewBag.NewThisWeek;
    var recent = (List<Lead>)ViewBag.Recent;
    var color = statuses.ToDictionary(o => o.Value, o => o.Color ?? "#64748b");
    var last = statuses.LastOrDefault();
    var href = Url.Action("Index", "Leads")!;
    var cards = new List<(string Label, int Value, string Icon, string Color)> {
        ("Total Leads", total, "bi-funnel", "#4f46e5"),
        ("New · last 7 days", newWeek, "bi-stars", "#f59e0b"),
        ("Unassigned", unassigned, "bi-person-exclamation", "#ef4444")
    };
    if (last != null) cards.Add((last.Label ?? last.Value, counts.GetValueOrDefault(last.Value), "bi-check2-circle", last.Color ?? "#14b8a6"));
}

<div class="mb-4 d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1">Welcome back, @fullName</h3>
        <p class="text-muted mb-0">Here is what's happening in your pipeline.</p>
    </div>
    <div class="text-muted small">Updated @Format.Stamp(DateTime.UtcNow, app.TimeZone, "hh:mm tt")</div>
</div>

@if (unassigned > 0)
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
        <div><div class="fw-semibold text-dark">Action required</div>
             <div class="small text-muted">@unassigned lead(s) have no staff assigned.</div></div>
        <a href="@href" class="btn btn-sm btn-primary ms-auto">Review</a>
    </div>
}

<div class="row g-3 g-lg-4 mb-4">
    @foreach (var c in cards)
    {
        <div class="col-6 col-xl-3">
            <a href="@href" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 card-hover" style="--c:@c.Color">
                    <div class="card-body p-3 p-lg-4">
                        <div class="kpi-icon mb-3"><i class="bi @c.Icon"></i></div>
                        <div class="text-muted small fw-medium">@c.Label</div>
                        <div class="fs-2 fw-bold text-dark">@c.Value</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 g-lg-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
            <h6 class="fw-bold mb-4">Pipeline</h6>
            @foreach (var s in statuses)
            {
                var n = counts.GetValueOrDefault(s.Value);
                var pct = total == 0 ? 0 : n * 100 / total;
                <div class="mb-3" style="--c:@color[s.Value]">
                    <div class="d-flex justify-content-between small mb-1"><span class="fw-medium">@(s.Label ?? s.Value)</span><span class="text-muted">@n</span></div>
                    <div class="funnel-track"><div class="funnel-fill" style="width:@pct%"></div></div>
                </div>
            }
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
            <h6 class="fw-bold mb-3">Recent leads</h6>
            @foreach (var l in recent)
            {
                <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                    <span class="lead-avatar">@Format.Initials(l.FullName)</span>
                    <div class="flex-grow-1"><div class="fw-semibold">@l.FullName</div><div class="small text-muted">@Format.Ago(l.CreatedAt)</div></div>
                    <span class="pill" style="--pill:@color.GetValueOrDefault(l.Status, "#64748b")">@l.Status</span>
                </div>
            }
        </div></div>
    </div>
</div>