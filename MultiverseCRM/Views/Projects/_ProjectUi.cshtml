@* Shared CSS + JS for Projects (Index / Create / Edit / Details).
   Include once per view:  <partial name="_ProjectUi" />
   NOTE: inside Razor, CSS at-rules are written @@media / @@keyframes. *@
<style>
    :root {
        --mv-brand: #5CD1FF;
        --mv-brand-deep: #0E7FB0;
        --mv-brand-soft: #E6F8FF;
        --mv-ok: #059669;
        --mv-bad: #DC2626;
        --mv-line: var(--glass-border, rgba(100,116,139,.28));
        --mv-muted: var(--ink-soft, #64748B);
        --mv-text: var(--ink, #0F172A);
    }
    [data-theme="dark"] { --mv-brand-soft: rgba(92,209,255,.12); --mv-brand-deep: #7DDCFF; }

    .mv-sr { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }

    /* ---------- Section titles ---------- */
    .mv-sec-title { display: flex; align-items: center; gap: .65rem; margin-bottom: 1rem; }
    .mv-sec-title h6 { margin: 0; font-weight: 700; color: var(--mv-text); }
    .mv-sec-title small { display: block; color: var(--mv-muted); font-weight: 400; font-size: .76rem; }
    .mv-ico {
        width: 34px; height: 34px; border-radius: 10px; flex: 0 0 34px;
        display: grid; place-items: center; font-size: 1rem;
        color: var(--c, var(--mv-brand-deep));
        background: color-mix(in srgb, var(--c, var(--mv-brand)) 14%, transparent);
    }
    .mv-hint { font-size: .72rem; color: var(--mv-ok); min-height: 1em; margin-top: .2rem; font-weight: 600; }

    /* ---------- Sticky action bar ---------- */
    .mv-actionbar {
        position: sticky; bottom: .75rem; z-index: 20;
        display: flex; justify-content: space-between; align-items: center; gap: .75rem; flex-wrap: wrap;
        padding: .7rem .9rem; border-radius: 1rem;
        background: var(--glass-strong, rgba(255,255,255,.85));
        border: 1px solid var(--mv-line);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 10px 30px rgba(15,23,42,.14);
    }
    .mv-actionbar .mv-ab-note { font-size: .8rem; color: var(--mv-muted); }
    .mv-actionbar .mv-ab-btns { display: flex; gap: .5rem; margin-left: auto; }

    /* ---------- Uploader ---------- */
    .mv-drop-zone {
        border: 2px dashed var(--mv-line); border-radius: 1rem;
        padding: 1.6rem 1rem; text-align: center; cursor: pointer;
        background: color-mix(in srgb, var(--mv-brand) 6%, transparent);
        transition: border-color .2s, background .2s;
    }
    .mv-drop-zone:hover, .mv-drop-zone:focus-visible { border-color: var(--mv-brand); outline: none; }
    .mv-uploader.is-over .mv-drop-zone { border-color: var(--mv-brand); background: var(--mv-brand-soft); border-style: solid; }
    .mv-uploader.is-busy .mv-drop-zone { opacity: .6; pointer-events: none; }
    .mv-drop-icon {
        width: 56px; height: 56px; margin: 0 auto .6rem; border-radius: 50%;
        display: grid; place-items: center; font-size: 1.6rem;
        background: var(--mv-brand-soft); color: var(--mv-brand-deep);
    }
    .mv-drop-title { font-weight: 700; color: var(--mv-text); }
    .mv-drop-sub { font-size: .8rem; color: var(--mv-muted); margin: .15rem 0 .8rem; }
    .mv-drop-actions { display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; }
    .mv-cam-btn { display: none; }
    @@media (pointer: coarse) { .mv-cam-btn { display: inline-flex; align-items: center; } }

    .mv-errors {
        margin-top: .75rem; padding: .6rem .8rem; border-radius: .7rem; font-size: .8rem;
        background: color-mix(in srgb, var(--mv-bad) 10%, transparent);
        color: var(--mv-bad); border: 1px solid color-mix(in srgb, var(--mv-bad) 30%, transparent);
    }
    .mv-errors ul { margin: 0; padding-left: 1.1rem; }
    .mv-sum { display: flex; justify-content: space-between; align-items: center; margin: .9rem 0 .5rem; font-size: .82rem; color: var(--mv-muted); }
    .mv-sum[hidden], .mv-errors[hidden] { display: none; }
    .mv-sum strong { color: var(--mv-text); }

    .mv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: .65rem; }
    .mv-tile {
        position: relative; aspect-ratio: 1; border-radius: .8rem; overflow: hidden;
        border: 1px solid var(--mv-line); background: #E2E8F0; cursor: grab;
    }
    .mv-tile.is-dragging { opacity: .35; }
    .mv-tile > img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .2s, filter .2s; }
    .mv-tile.is-cover { outline: 2px solid var(--mv-brand); outline-offset: -2px; }
    .mv-tile-x, .mv-cover-btn, .mv-badge-cover, .mv-cover-lbl {
        position: absolute; border: 0; font-size: .68rem; font-weight: 700; line-height: 1;
        display: inline-flex; align-items: center; gap: .25rem; cursor: pointer;
    }
    .mv-tile-x {
        top: .35rem; right: .35rem; width: 26px; height: 26px; border-radius: 50%; justify-content: center;
        background: rgba(15,23,42,.72); color: #fff; backdrop-filter: blur(6px);
    }
    .mv-tile-x:hover { background: var(--mv-bad); }
    .mv-badge-cover, .mv-cover-btn, .mv-cover-lbl {
        top: .35rem; left: .35rem; padding: .28rem .5rem; border-radius: 999px;
        background: rgba(15,23,42,.72); color: #fff; backdrop-filter: blur(6px);
    }
    .mv-badge-cover, .mv-cover-radio:checked ~ .mv-cover-lbl { background: var(--mv-brand); color: #04364D; }
    .mv-cover-btn:hover, .mv-cover-lbl:hover { background: rgba(15,23,42,.9); }
    .mv-cover-radio:checked ~ .mv-cover-lbl:hover { background: var(--mv-brand); }
    .mv-cover-lbl .on { display: none; }
    .mv-cover-radio:checked ~ .mv-cover-lbl .on { display: inline-flex; gap: .25rem; align-items: center; }
    .mv-cover-radio:checked ~ .mv-cover-lbl .off { display: none; }
    .mv-tile-cap {
        position: absolute; left: 0; right: 0; bottom: 0; padding: 1rem .5rem .3rem;
        font-size: .66rem; color: #fff; background: linear-gradient(transparent, rgba(2,6,23,.75));
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .mv-keep:not(:checked) ~ img { opacity: .3; filter: grayscale(1); }
    .mv-ex-flag {
        display: none; position: absolute; inset: 0; align-items: center; justify-content: center; text-align: center;
        font-size: .72rem; font-weight: 700; color: var(--mv-bad); pointer-events: none; padding: .5rem;
    }
    .mv-keep:not(:checked) ~ .mv-ex-flag { display: flex; }
    .mv-keep:focus-visible ~ .mv-tile-x, .mv-cover-radio:focus-visible ~ .mv-cover-lbl { outline: 2px solid var(--mv-brand-deep); outline-offset: 2px; }
    .mv-ex { cursor: default; }

    .mv-docs { display: flex; flex-direction: column; gap: .45rem; }
    .mv-doc {
        display: flex; align-items: center; gap: .7rem; padding: .55rem .7rem;
        border: 1px solid var(--mv-line); border-radius: .75rem;
    }
    .mv-doc-ico { font-size: 1.4rem; line-height: 1; }
    .mv-doc-name { font-size: .85rem; font-weight: 600; color: var(--mv-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mv-doc-size { font-size: .72rem; color: var(--mv-muted); }
    .mv-doc .mv-doc-x { margin-left: auto; border: 0; background: transparent; color: var(--mv-muted); padding: .25rem .4rem; border-radius: .4rem; }
    .mv-doc .mv-doc-x:hover { color: var(--mv-bad); background: color-mix(in srgb, var(--mv-bad) 10%, transparent); }
    .mv-doc .min-w-0 { min-width: 0; }

    /* ---------- Amenity chips ---------- */
    .mv-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .7rem; }
    .mv-chip {
        border: 1px solid var(--mv-line); background: transparent; color: var(--mv-text);
        padding: .28rem .65rem; border-radius: 999px; font-size: .76rem; font-weight: 600;
        transition: background .15s, border-color .15s;
    }
    .mv-chip:hover { border-color: var(--mv-brand); }
    .mv-chip.active { background: var(--mv-brand); border-color: var(--mv-brand); color: #04364D; }
    .mv-chip.active::before { content: "\2713\00a0"; }

    /* ---------- Projects list ---------- */
    .project-card {
        background: var(--glass-strong, #fff); border: 1px solid var(--mv-line);
        border-radius: var(--radius, 1rem); overflow: hidden; height: 100%;
        display: flex; flex-direction: column;
        transition: transform .25s var(--ease, ease), box-shadow .25s var(--ease, ease);
    }
    .project-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift, 0 14px 30px rgba(15,23,42,.14)); }
    .project-card-img {
        aspect-ratio: 16/10; position: relative; overflow: hidden;
        background: linear-gradient(135deg, #E6F8FF, #BFEBFF);
        display: flex; align-items: center; justify-content: center;
    }
    .project-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease, ease); }
    .project-card:hover .project-card-img img { transform: scale(1.04); }
    .project-card-img::after { content: ""; position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(transparent, rgba(2,6,23,.55)); pointer-events: none; }
    .project-card-img .placeholder-icon { font-size: 3rem; color: var(--mv-brand-deep); opacity: .45; }
    [data-theme="dark"] .project-card-img { background: linear-gradient(135deg, #1E293B, #334155); }
    .pc-status {
        position: absolute; top: .65rem; left: .65rem; z-index: 2;
        display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .65rem; border-radius: 999px;
        background: rgba(255,255,255,.88); color: #0F172A; font-size: .7rem; font-weight: 700; backdrop-filter: blur(8px);
    }
    .pc-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--d, #64748B); display: inline-block; }
    .st-upcoming { --d: #F59E0B; } .st-construction { --d: #0EA5E9; } .st-ready { --d: #10B981; } .st-done { --d: #64748B; }
    .pc-featured {
        position: absolute; top: .65rem; right: .65rem; z-index: 2; width: 30px; height: 30px; border-radius: 50%;
        display: grid; place-items: center; background: #F59E0B; color: #fff; font-size: .85rem;
        box-shadow: 0 4px 12px rgba(245,158,11,.45);
    }
    .pc-photos {
        position: absolute; right: .65rem; bottom: .6rem; z-index: 2; color: #fff; font-size: .72rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: .3rem;
    }
    .project-card-body { padding: .9rem 1rem 1rem; flex: 1 1 auto; display: flex; flex-direction: column; gap: .15rem; }
    .project-card-title { font-weight: 700; font-size: 1.02rem; color: var(--mv-text); }
    .project-card-meta { font-size: .8rem; color: var(--mv-muted); }
    .pc-bottom { margin-top: auto; padding-top: .75rem; display: flex; justify-content: space-between; align-items: flex-end; gap: .5rem; }
    .project-card-price { font-weight: 800; font-size: 1rem; color: var(--mv-ok); line-height: 1.15; }
    .pc-price-none { font-size: .8rem; color: var(--mv-muted); font-weight: 500; }
    .pc-poss { font-size: .72rem; color: var(--mv-muted); text-align: right; white-space: nowrap; }
    [data-theme="dark"] .project-card-price { color: #34D399; }

    .mv-filter-chip {
        display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .6rem; border-radius: 999px;
        font-size: .75rem; font-weight: 600; text-decoration: none;
        background: var(--mv-brand-soft); color: var(--mv-brand-deep);
    }
    .mv-filter-chip:hover { filter: brightness(.96); }

    /* ---------- Details gallery ---------- */
    .mv-stage { position: relative; border-radius: 1rem; overflow: hidden; background: #0F172A; aspect-ratio: 16/9; }
    .mv-stage-img { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; display: block; }
    .mv-nav {
        position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border: 0; border-radius: 50%;
        background: rgba(255,255,255,.85); color: #0F172A; display: grid; place-items: center; font-size: 1.05rem;
    }
    .mv-nav:hover { background: #fff; }
    .mv-nav.prev { left: .7rem; } .mv-nav.next { right: .7rem; }
    .mv-stage-count {
        position: absolute; right: .7rem; bottom: .7rem; padding: .25rem .6rem; border-radius: 999px;
        background: rgba(15,23,42,.7); color: #fff; font-size: .72rem; font-weight: 600;
    }
    .mv-thumbs { display: flex; gap: .5rem; overflow-x: auto; padding: .6rem 2px .2rem; scrollbar-width: thin; }
    .mv-thumb {
        flex: 0 0 82px; height: 58px; padding: 0; border: 2px solid transparent; border-radius: .6rem;
        overflow: hidden; background: none; opacity: .65; transition: opacity .15s, border-color .15s;
    }
    .mv-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .mv-thumb:hover { opacity: 1; }
    .mv-thumb.active { opacity: 1; border-color: var(--mv-brand); }
    .mv-empty-stage { aspect-ratio: 16/9; border-radius: 1rem; display: grid; place-items: center; text-align: center; color: var(--mv-muted); border: 2px dashed var(--mv-line); }

    .mv-lb { position: fixed; inset: 0; z-index: 2000; background: rgba(2,6,23,.94); display: none; align-items: center; justify-content: center; }
    .mv-lb.open { display: flex; }
    .mv-lb img { max-width: 94vw; max-height: 88vh; object-fit: contain; border-radius: .5rem; }
    .mv-lb .mv-nav { background: rgba(255,255,255,.14); color: #fff; }
    .mv-lb .mv-nav:hover { background: rgba(255,255,255,.28); }
    .mv-lb-close { position: absolute; top: .9rem; right: .9rem; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; }
    .mv-lb-count { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); color: #fff; font-size: .8rem; opacity: .8; }

    .mv-price-big { font-size: 1.55rem; font-weight: 800; color: var(--mv-ok); line-height: 1.1; }
    .mv-facts { display: grid; gap: .7rem; margin: 0; }
    .mv-fact { display: flex; gap: .7rem; align-items: flex-start; }
    .mv-fact > i { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: var(--mv-brand-soft); color: var(--mv-brand-deep); flex: 0 0 30px; font-size: .9rem; }
    .mv-fact dt { font-size: .72rem; font-weight: 500; color: var(--mv-muted); margin: 0; }
    .mv-fact dd { margin: 0; font-weight: 600; color: var(--mv-text); font-size: .9rem; }
    .mv-sticky { position: sticky; top: 1rem; }
    .mv-amenity { display: inline-flex; align-items: center; gap: .4rem; padding: .4rem .75rem; border-radius: .7rem; font-size: .82rem; font-weight: 600; border: 1px solid var(--mv-line); color: var(--mv-text); }
    .mv-amenity i { color: var(--mv-brand-deep); }

    @@media (max-width: 575.98px) {
        .mv-grid { grid-template-columns: repeat(3, 1fr); gap: .45rem; }
        .mv-actionbar .mv-ab-btns { width: 100%; }
        .mv-actionbar .mv-ab-btns .btn { flex: 1; }
        .mv-actionbar .mv-ab-note { display: none; }
        .mv-nav { width: 34px; height: 34px; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .project-card, .project-card-img img, .mv-drop-zone, .mv-tile > img { transition: none; }
    }
</style>

<script>
(function () {
    'use strict';

    /* ---------- helpers ---------- */
    var MB = 1048576;
    function fmtSize(b) { return b < MB ? Math.max(1, Math.round(b / 1024)) + ' KB' : (b / MB).toFixed(1) + ' MB'; }
    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
    function icon(cls) { return el('i', 'bi ' + cls); }
    function srcId(f) { return f.name + '|' + f.size + '|' + f.lastModified; }

    // Big phone photos get resized/compressed in the browser instead of being rejected.
    function toJpeg(canvas, q) { return new Promise(function (res) { canvas.toBlob(res, 'image/jpeg', q); }); }
    async function optimize(file, maxBytes) {
        if (!/^image\/(jpeg|png|webp)$/.test(file.type) || typeof createImageBitmap !== 'function') return file;
        try {
            var bmp = await createImageBitmap(file);
            var scale = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
            var needs = file.size > maxBytes || (scale < 1 && file.size > 2 * MB);
            if (!needs) { if (bmp.close) bmp.close(); return file; }
            var c = document.createElement('canvas');
            c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
            var ctx = c.getContext('2d');
            ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
            ctx.drawImage(bmp, 0, 0, c.width, c.height);
            if (bmp.close) bmp.close();
            var qs = [0.86, 0.72, 0.58];
            for (var i = 0; i < qs.length; i++) {
                var blob = await toJpeg(c, qs[i]);
                if (blob && blob.size <= maxBytes && blob.size < file.size) {
                    return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg', lastModified: file.lastModified });
                }
            }
        } catch (e) { /* fall through */ }
        return file;
    }

    var DOC_ICONS = {
        pdf: ['bi-file-earmark-pdf', '#DC2626'], doc: ['bi-file-earmark-word', '#2563EB'], docx: ['bi-file-earmark-word', '#2563EB'],
        xls: ['bi-file-earmark-excel', '#16A34A'], xlsx: ['bi-file-earmark-excel', '#16A34A']
    };

    /* ---------- uploader ---------- */
    function initUploader(root) {
        var kind = root.dataset.kind || 'image';
        var maxMb = parseFloat(root.dataset.maxMb) || 5;
        var maxBytes = maxMb * MB;
        var maxFiles = parseInt(root.dataset.maxFiles, 10) || 40;
        var exts = (root.dataset.exts || '').split(',').filter(Boolean);
        var coverMode = kind === 'image' && root.dataset.cover !== 'false';
        var input = root.querySelector('.mv-input');
        var camera = root.querySelector('.mv-camera-input');
        var zone = root.querySelector('.mv-drop-zone');
        var list = root.querySelector('.mv-list');
        var sum = root.querySelector('.mv-sum');
        var sumText = root.querySelector('.mv-sum-text');
        var errBox = root.querySelector('.mv-errors');
        var files = [], urls = new Map(), dragIdx = null, busy = false;

        function sync() {
            var dt = new DataTransfer();
            files.forEach(function (f) { dt.items.add(f); });
            input.files = dt.files;
        }
        function showErrors(errs) {
            errBox.textContent = '';
            if (!errs.length) { errBox.hidden = true; return; }
            var ul = el('ul'); errs.slice(0, 8).forEach(function (m) { ul.appendChild(el('li', null, m)); });
            if (errs.length > 8) ul.appendChild(el('li', null, '…and ' + (errs.length - 8) + ' more'));
            errBox.appendChild(ul); errBox.hidden = false;
        }
        function removeAt(i) {
            var f = files.splice(i, 1)[0];
            if (urls.has(f)) { URL.revokeObjectURL(urls.get(f)); urls.delete(f); }
            sync(); render();
        }
        function move(from, to) {
            if (from === to) return;
            var f = files.splice(from, 1)[0]; files.splice(to, 0, f); sync(); render();
        }
        function render() {
            list.textContent = '';
            files.forEach(function (f, i) {
                if (kind === 'image') {
                    if (!urls.has(f)) urls.set(f, URL.createObjectURL(f));
                    var t = el('div', 'mv-tile' + (coverMode && i === 0 ? ' is-cover' : ''));
                    t.draggable = true;
                    var img = el('img'); img.src = urls.get(f); img.alt = f.name; t.appendChild(img);
                    if (coverMode) {
                        if (i === 0) { var b = el('span', 'mv-badge-cover'); b.appendChild(icon('bi-star-fill')); b.appendChild(document.createTextNode(' Cover')); t.appendChild(b); }
                        else {
                            var cb = el('button', 'mv-cover-btn'); cb.type = 'button'; cb.title = 'Make this the cover photo';
                            cb.appendChild(icon('bi-star')); cb.appendChild(document.createTextNode(' Make cover'));
                            cb.addEventListener('click', function () { move(i, 0); });
                            t.appendChild(cb);
                        }
                    }
                    var x = el('button', 'mv-tile-x'); x.type = 'button'; x.title = 'Remove'; x.setAttribute('aria-label', 'Remove ' + f.name);
                    x.appendChild(icon('bi-x-lg')); x.addEventListener('click', function () { removeAt(i); }); t.appendChild(x);
                    var cap = f.__orig && f.__orig > f.size ? fmtSize(f.size) + ' · optimized' : fmtSize(f.size);
                    t.appendChild(el('div', 'mv-tile-cap', cap));
                    t.addEventListener('dragstart', function (e) { dragIdx = i; t.classList.add('is-dragging'); e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', 'mv'); });
                    t.addEventListener('dragend', function () { dragIdx = null; t.classList.remove('is-dragging'); });
                    t.addEventListener('dragover', function (e) { if (dragIdx !== null) e.preventDefault(); });
                    t.addEventListener('drop', function (e) { if (dragIdx === null) return; e.preventDefault(); e.stopPropagation(); var from = dragIdx; dragIdx = null; move(from, i); });
                    list.appendChild(t);
                } else {
                    var ext = f.name.split('.').pop().toLowerCase();
                    var di = DOC_ICONS[ext] || ['bi-file-earmark', '#64748B'];
                    var row = el('div', 'mv-doc');
                    var ic = icon(di[0] + ' mv-doc-ico'); ic.style.color = di[1]; row.appendChild(ic);
                    var wrap = el('div', 'min-w-0'); wrap.appendChild(el('div', 'mv-doc-name', f.name)); wrap.appendChild(el('div', 'mv-doc-size', fmtSize(f.size))); row.appendChild(wrap);
                    var rx = el('button', 'mv-doc-x'); rx.type = 'button'; rx.setAttribute('aria-label', 'Remove ' + f.name); rx.appendChild(icon('bi-x-lg'));
                    rx.addEventListener('click', function () { removeAt(i); }); row.appendChild(rx);
                    list.appendChild(row);
                }
            });
            var total = files.reduce(function (s, f) { return s + f.size; }, 0);
            sum.hidden = files.length === 0;
            sumText.textContent = '';
            var strong = el('strong', null, files.length + (kind === 'image' ? (files.length === 1 ? ' photo' : ' photos') : (files.length === 1 ? ' file' : ' files')));
            sumText.appendChild(strong); sumText.appendChild(document.createTextNode(' · ' + fmtSize(total) +
                (coverMode && files.length > 1 ? ' · drag to reorder, first photo is the cover' : '')));
        }
        async function add(fileList) {
            var errs = [];
            busy = true; root.classList.add('is-busy'); root.dataset.busy = '1';
            try {
                var arr = Array.prototype.slice.call(fileList);
                for (var n = 0; n < arr.length; n++) {
                    var f0 = arr[n];
                    if (files.length >= maxFiles) { errs.push('You can add up to ' + maxFiles + ' files at a time.'); break; }
                    if (kind === 'image' && f0.type.indexOf('image/') !== 0) { errs.push(f0.name + ': not an image'); continue; }
                    if (kind === 'doc') {
                        var ext = f0.name.split('.').pop().toLowerCase();
                        if (exts.indexOf(ext) < 0) { errs.push(f0.name + ': .' + ext + ' files are not supported'); continue; }
                    }
                    if (f0.size === 0) { errs.push(f0.name + ': file is empty'); continue; }
                    var id = srcId(f0);
                    if (files.some(function (x) { return x.__src === id; })) { errs.push(f0.name + ': already added'); continue; }
                    var f = kind === 'image' ? await optimize(f0, maxBytes) : f0;
                    if (f.size > maxBytes) { errs.push(f0.name + ' is ' + fmtSize(f0.size) + ' — limit is ' + maxMb + ' MB'); continue; }
                    f.__src = id; f.__orig = f0.size; files.push(f);
                }
            } finally {
                busy = false; root.classList.remove('is-busy'); delete root.dataset.busy;
                sync(); render(); showErrors(errs);
            }
        }

        zone.addEventListener('click', function () { input.click(); });
        zone.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
        input.addEventListener('change', function () { var picked = Array.prototype.slice.call(input.files); add(picked); });
        if (camera) {
            var camBtn = root.querySelector('.mv-camera');
            if (camBtn) camBtn.addEventListener('click', function (e) { e.stopPropagation(); camera.click(); });
            camera.addEventListener('change', function () { var p = Array.prototype.slice.call(camera.files); camera.value = ''; add(p); });
        }
        root.querySelector('.mv-clear').addEventListener('click', function () {
            urls.forEach(function (u) { URL.revokeObjectURL(u); }); urls.clear(); files = []; sync(); render(); showErrors([]);
        });

        function hasFiles(e) { return e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0; }
        var depth = 0;
        root.addEventListener('dragenter', function (e) { if (!hasFiles(e)) return; e.preventDefault(); depth++; root.classList.add('is-over'); });
        root.addEventListener('dragover', function (e) { if (hasFiles(e)) e.preventDefault(); });
        root.addEventListener('dragleave', function (e) { if (!hasFiles(e)) return; depth = Math.max(0, depth - 1); if (!depth) root.classList.remove('is-over'); });
        root.addEventListener('drop', function (e) {
            if (!hasFiles(e)) return;
            e.preventDefault(); depth = 0; root.classList.remove('is-over'); add(e.dataTransfer.files);
        });
        root.__mvBusy = function () { return busy; };
        root.__mvCount = function () { return files.length; };
    }

    /* ---------- init on DOM ready ---------- */
    function ready(fn) { if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }
    ready(function () {
        // Uploaders
        document.querySelectorAll('.mv-uploader').forEach(initUploader);

        // Stop the browser from opening a file that's dropped outside a drop zone
        ['dragover', 'drop'].forEach(function (ev) {
            window.addEventListener(ev, function (e) {
                if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0 && !e.target.closest('.mv-uploader')) e.preventDefault();
            });
        });

        // Forms: block double submit + show progress
        document.querySelectorAll('form[data-mv-form]').forEach(function (form) {
            var btn = form.querySelector('[data-mv-submit]');
            var original = btn ? btn.innerHTML : '';
            form.addEventListener('submit', function (e) {
                var ups = Array.prototype.slice.call(form.querySelectorAll('.mv-uploader'));
                if (ups.some(function (u) { return u.__mvBusy && u.__mvBusy(); })) { e.preventDefault(); alert('Photos are still being prepared. Please try again in a moment.'); return; }
                if (btn) {
                    var n = ups.reduce(function (s, u) { return s + (u.__mvCount ? u.__mvCount() : 0); }, 0);
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + (n ? 'Uploading ' + n + (n === 1 ? ' file…' : ' files…') : 'Saving…');
                }
            });
            window.addEventListener('pageshow', function () { if (btn) { btn.disabled = false; btn.innerHTML = original; } });
        });

        // Price hint in Lakh / Crore
        function inr(n) {
            if (!n || n < 0) return '';
            if (n >= 1e7) return '≈ ₹' + parseFloat((n / 1e7).toFixed(2)) + ' Cr';
            if (n >= 1e5) return '≈ ₹' + parseFloat((n / 1e5).toFixed(2)) + ' Lakh';
            if (n >= 1e3) return '≈ ₹' + parseFloat((n / 1e3).toFixed(1)) + ' K';
            return '';
        }
        document.querySelectorAll('input[data-inr]').forEach(function (i) {
            var hint = i.parentElement.querySelector('.mv-hint') || i.closest('div').querySelector('.mv-hint');
            var upd = function () { if (hint) hint.textContent = inr(parseFloat(i.value)); };
            i.addEventListener('input', upd); upd();
        });

        // Amenity quick-pick chips
        document.querySelectorAll('.mv-chips[data-target]').forEach(function (box) {
            var ta = document.querySelector(box.dataset.target);
            if (!ta) return;
            var counter = document.querySelector(box.dataset.counter || '');
            function items() { return ta.value.split(/[\n,]+/).map(function (s) { return s.trim(); }).filter(Boolean); }
            function paint() {
                var low = items().map(function (s) { return s.toLowerCase(); });
                box.querySelectorAll('.mv-chip').forEach(function (c) { c.classList.toggle('active', low.indexOf(c.dataset.v.toLowerCase()) >= 0); });
                if (counter) counter.textContent = items().length;
            }
            box.addEventListener('click', function (e) {
                var c = e.target.closest('.mv-chip'); if (!c) return;
                var cur = items(), idx = cur.map(function (s) { return s.toLowerCase(); }).indexOf(c.dataset.v.toLowerCase());
                if (idx >= 0) cur.splice(idx, 1); else cur.push(c.dataset.v);
                ta.value = cur.join('\n'); paint();
            });
            ta.addEventListener('input', paint); paint();
        });

        // Possession date can't be before launch date
        var launch = document.querySelector('[data-launch]'), poss = document.querySelector('[data-possession]');
        if (launch && poss) {
            var lim = function () { poss.min = launch.value || ''; };
            launch.addEventListener('change', lim); lim();
        }

        // Edit: "N images will be removed"
        var keepSum = document.querySelector('[data-keep-summary]');
        if (keepSum) {
            var keeps = document.querySelectorAll('.mv-keep');
            var upd = function () {
                var n = Array.prototype.filter.call(keeps, function (k) { return !k.checked; }).length;
                keepSum.textContent = n ? n + (n === 1 ? ' image' : ' images') + ' will be removed when you save' : 'Tap the bin icon on a photo to remove it';
                keepSum.style.color = n ? 'var(--mv-bad)' : '';
            };
            keeps.forEach(function (k) { k.addEventListener('change', upd); }); upd();
        }

        // Filters auto-apply
        document.querySelectorAll('form[data-autosubmit] select').forEach(function (s) {
            s.addEventListener('change', function () { s.form.requestSubmit ? s.form.requestSubmit() : s.form.submit(); });
        });

        // Confirm dialogs (safe with quotes in names)
        document.querySelectorAll('form[data-confirm]').forEach(function (f) {
            f.addEventListener('submit', function (e) { if (!confirm(f.dataset.confirm)) e.preventDefault(); });
        });

        // Gallery + lightbox
        var gal = document.querySelector('.mv-gallery');
        if (gal) {
            var thumbs = Array.prototype.slice.call(gal.querySelectorAll('.mv-thumb'));
            var stageImg = gal.querySelector('.mv-stage-img'), count = gal.querySelector('.mv-stage-count');
            var lb = document.querySelector('.mv-lb'), lbImg = lb.querySelector('img'), lbCount = lb.querySelector('.mv-lb-count');
            var cur = 0, total = thumbs.length;
            function show(i) {
                cur = (i + total) % total;
                var t = thumbs[cur];
                stageImg.src = t.dataset.src; stageImg.alt = t.dataset.alt || '';
                count.textContent = (cur + 1) + ' / ' + total;
                thumbs.forEach(function (x, k) { x.classList.toggle('active', k === cur); });
                t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
                if (lb.classList.contains('open')) { lbImg.src = t.dataset.src; lbCount.textContent = (cur + 1) + ' / ' + total; }
            }
            function openLb() { lb.classList.add('open'); document.body.style.overflow = 'hidden'; show(cur); }
            function closeLb() { lb.classList.remove('open'); document.body.style.overflow = ''; }
            thumbs.forEach(function (t, i) { t.addEventListener('click', function () { show(i); }); });
            document.querySelectorAll('[data-gal="prev"]').forEach(function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); show(cur - 1); }); });
            document.querySelectorAll('[data-gal="next"]').forEach(function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); show(cur + 1); }); });
            stageImg.addEventListener('click', openLb);
            lb.querySelector('.mv-lb-close').addEventListener('click', closeLb);
            lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
            document.addEventListener('keydown', function (e) {
                if (!lb.classList.contains('open')) return;
                if (e.key === 'Escape') closeLb(); else if (e.key === 'ArrowLeft') show(cur - 1); else if (e.key === 'ArrowRight') show(cur + 1);
            });
            var sx = null;
            [gal.querySelector('.mv-stage'), lb].forEach(function (zone) {
                zone.addEventListener('touchstart', function (e) { sx = e.changedTouches[0].clientX; }, { passive: true });
                zone.addEventListener('touchend', function (e) {
                    if (sx === null) return; var dx = e.changedTouches[0].clientX - sx; sx = null;
                    if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
                }, { passive: true });
            });
            show(0);
        }
    });
})();
</script>
