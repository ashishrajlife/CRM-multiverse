@model MultiverseCRM.ViewModels.ProjectDetailViewModel
@{
    ViewData["Title"] = Model.Project.Name;
    var p = Model.Project;
    var heroImg = Model.Images.FirstOrDefault(i => i.IsHero) ?? Model.Images.FirstOrDefault();
    // hero first, then the rest
    var images = Model.Images.Where(i => i == heroImg).Concat(Model.Images.Where(i => i != heroImg)).ToList();

    string StatusClass(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "upcoming" => "st-upcoming",
        "under construction" => "st-construction",
        "ready to move" => "st-ready",
        _ => "st-done"
    };
}

<partial name="_ProjectUi" />

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <a asp-action="Index" class="text-decoration-none small text-muted">
            <i class="bi bi-arrow-left me-1"></i>Back to Projects
        </a>
        <h3 class="fw-bold mb-1 mt-1">@p.Name</h3>
        <div class="d-flex align-items-center flex-wrap gap-2 text-muted">
            @if (!string.IsNullOrEmpty(p.Location) || !string.IsNullOrEmpty(p.City))
            {
                <span><i class="bi bi-geo-alt me-1"></i>@(string.Join(", ", new[] { p.Location, p.City }.Where(x => !string.IsNullOrWhiteSpace(x))))</span>
            }
            @if (!string.IsNullOrEmpty(p.Status))
            {
                <span class="pc-status @StatusClass(p.Status)" style="position:static;"><i></i>@p.Status</span>
            }
            @if (p.IsFeatured)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Featured</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <form asp-action="ToggleFeatured" asp-route-id="@p.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm @(p.IsFeatured ? "btn-warning" : "btn-outline-warning")">
                <i class="bi bi-star@(p.IsFeatured ? "-fill" : "") me-1"></i>@(p.IsFeatured ? "Featured" : "Feature")
            </button>
        </form>
        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
              data-confirm="Delete @p.Name? This removes its photos and documents too.">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row g-3 g-lg-4">
    <div class="col-lg-8">

        <!-- Gallery -->
        @if (images.Count > 0)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-2 p-md-3">
                    <div class="mv-gallery">
                        <div class="mv-stage">
                            <img class="mv-stage-img" src="~/@images[0].FilePath" alt="@p.Name" />
                            @if (images.Count > 1)
                            {
                                <button type="button" class="mv-nav prev" data-gal="prev" aria-label="Previous photo"><i class="bi bi-chevron-left"></i></button>
                                <button type="button" class="mv-nav next" data-gal="next" aria-label="Next photo"><i class="bi bi-chevron-right"></i></button>
                            }
                            <span class="mv-stage-count">1 / @images.Count</span>
                        </div>
                        @if (images.Count > 1)
                        {
                            <div class="mv-thumbs">
                                @foreach (var img in images)
                                {
                                    <button type="button" class="mv-thumb" data-src="@Url.Content("~/" + img.FilePath)" data-alt="@img.Caption" aria-label="Show photo">
                                        <img src="~/@img.FilePath" alt="" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <button type="button" class="mv-thumb d-none" data-src="@Url.Content("~/" + images[0].FilePath)" data-alt="@images[0].Caption"></button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-3">
                    <div class="mv-empty-stage">
                        <div>
                            <i class="bi bi-images fs-1"></i>
                            <div class="mt-2">No photos yet</div>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary mt-2">
                                <i class="bi bi-cloud-arrow-up me-1"></i>Add photos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="mv-sec-title">
                        <span class="mv-ico" style="--c:#6366F1"><i class="bi bi-card-text"></i></span>
                        <h6>About this project</h6>
                    </div>
                    <p class="mb-0" style="white-space: pre-line; max-width: 75ch;">@p.Description</p>
                </div>
            </div>
        }

        @if (Model.Amenities.Count > 0)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="mv-sec-title">
                        <span class="mv-ico" style="--c:#0EA5E9"><i class="bi bi-check2-square"></i></span>
                        <h6>Amenities<small>@Model.Amenities.Count included</small></h6>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var a in Model.Amenities)
                        {
                            <span class="mv-amenity"><i class="bi @(a.Icon ?? "bi-check2-circle")"></i>@a.Name</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="mv-sticky">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    @if (p.MinPrice.HasValue || p.MaxPrice.HasValue)
                    {
                        <div class="small text-muted mb-1">@(p.MinPrice.HasValue && p.MaxPrice.HasValue ? "Price range" : "Price")</div>
                        <div class="mv-price-big mb-3">
                            ₹@((p.MinPrice ?? p.MaxPrice)!.Value.ToString("N0"))
                            @if (p.MinPrice.HasValue && p.MaxPrice.HasValue)
                            {
                                <text> – ₹@p.MaxPrice.Value.ToString("N0")</text>
                            }
                        </div>
                        <hr class="mt-0" />
                    }
                    <dl class="mv-facts">
                        @if (!string.IsNullOrEmpty(p.Developer))
                        {
                            <div class="mv-fact"><i class="bi bi-person-workspace"></i><div><dt>Developer</dt><dd>@p.Developer</dd></div></div>
                        }
                        @if (!string.IsNullOrEmpty(p.ProjectType))
                        {
                            <div class="mv-fact"><i class="bi bi-buildings"></i><div><dt>Type</dt><dd>@p.ProjectType</dd></div></div>
                        }
                        @if (p.TotalArea.HasValue)
                        {
                            <div class="mv-fact"><i class="bi bi-aspect-ratio"></i><div><dt>Total area</dt><dd>@p.TotalArea.Value.ToString("N2") @(p.AreaUnit ?? "Sqft")</dd></div></div>
                        }
                        @if (p.TotalUnits.HasValue)
                        {
                            <div class="mv-fact"><i class="bi bi-grid-3x3-gap"></i><div><dt>Total units</dt><dd>@p.TotalUnits</dd></div></div>
                        }
                        @if (p.LaunchDate.HasValue)
                        {
                            <div class="mv-fact"><i class="bi bi-rocket-takeoff"></i><div><dt>Launch</dt><dd>@p.LaunchDate.Value.ToString("dd MMM yyyy")</dd></div></div>
                        }
                        @if (p.PossessionDate.HasValue)
                        {
                            <div class="mv-fact"><i class="bi bi-key"></i><div><dt>Possession</dt><dd>@p.PossessionDate.Value.ToString("dd MMM yyyy")</dd></div></div>
                        }
                        @if (!string.IsNullOrEmpty(p.ReraNumber))
                        {
                            <div class="mv-fact"><i class="bi bi-patch-check"></i><div><dt>RERA</dt><dd><code>@p.ReraNumber</code></dd></div></div>
                        }
                    </dl>
                </div>
            </div>

            @if (Model.Documents.Count > 0)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="mv-sec-title">
                            <span class="mv-ico" style="--c:#DC2626"><i class="bi bi-folder2-open"></i></span>
                            <h6>Documents<small>@Model.Documents.Count file@(Model.Documents.Count == 1 ? "" : "s")</small></h6>
                        </div>
                        <div class="mv-docs">
                            @foreach (var doc in Model.Documents)
                            {
                                var ext = System.IO.Path.GetExtension(doc.FilePath ?? "").ToLowerInvariant();
                                var (dIcon, dColor) = ext switch
                                {
                                    ".pdf" => ("bi-file-earmark-pdf", "#DC2626"),
                                    ".doc" or ".docx" => ("bi-file-earmark-word", "#2563EB"),
                                    ".xls" or ".xlsx" => ("bi-file-earmark-excel", "#16A34A"),
                                    _ => ("bi-file-earmark", "#64748B")
                                };
                                <a href="~/@doc.FilePath" target="_blank" class="mv-doc text-decoration-none">
                                    <i class="bi @dIcon mv-doc-ico" style="color:@dColor"></i>
                                    <div class="min-w-0">
                                        <div class="mv-doc-name">@doc.Name</div>
                                        <div class="mv-doc-size">@((doc.FileSizeBytes / 1024.0).ToString("F1")) KB</div>
                                    </div>
                                    <i class="bi bi-download ms-auto text-muted"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Lightbox -->
<div class="mv-lb" role="dialog" aria-label="Photo viewer">
    <button type="button" class="mv-lb-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    <button type="button" class="mv-nav prev" data-gal="prev" aria-label="Previous photo"><i class="bi bi-chevron-left"></i></button>
    <img src="" alt="" />
    <button type="button" class="mv-nav next" data-gal="next" aria-label="Next photo"><i class="bi bi-chevron-right"></i></button>
    <span class="mv-lb-count"></span>
</div>
