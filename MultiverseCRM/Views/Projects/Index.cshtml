@model MultiverseCRM.ViewModels.ProjectListViewModel
@{
    ViewData["Title"] = "Projects";
    var baseUrl = Url.Action("Index", "Projects")!;

    string PageUrl(int p) =>
        $"{baseUrl}?search={Uri.EscapeDataString(Model.Search ?? "")}" +
        (string.IsNullOrEmpty(Model.CityFilter) ? "" : $"&city={Uri.EscapeDataString(Model.CityFilter)}") +
        (string.IsNullOrEmpty(Model.StatusFilter) ? "" : $"&status={Uri.EscapeDataString(Model.StatusFilter)}") +
        $"&sortBy={Model.SortBy}&sortOrder={Model.SortOrder}&page={p}&pageSize={Model.PageSize}";

    // URL that keeps every filter except the one being removed
    string WithoutFilter(string remove) =>
        $"{baseUrl}?search={(remove == "search" ? "" : Uri.EscapeDataString(Model.Search ?? ""))}" +
        (remove == "city" || string.IsNullOrEmpty(Model.CityFilter) ? "" : $"&city={Uri.EscapeDataString(Model.CityFilter)}") +
        (remove == "status" || string.IsNullOrEmpty(Model.StatusFilter) ? "" : $"&status={Uri.EscapeDataString(Model.StatusFilter)}") +
        $"&sortBy={Model.SortBy}&sortOrder={Model.SortOrder}&pageSize={Model.PageSize}";

    string StatusClass(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "upcoming" => "st-upcoming",
        "under construction" => "st-construction",
        "ready to move" => "st-ready",
        _ => "st-done"
    };

    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.CityFilter) || !string.IsNullOrEmpty(Model.StatusFilter);
}

<partial name="_ProjectUi" />
<!-- Stats -->
<div class="row g-2 g-lg-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card" style="--c:#4f46e5">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon"><i class="bi bi-building"></i></div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-truncate">Total</div>
                    <div class="fs-2 fw-bold" style="color:var(--ink);">@Model.TotalCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card" style="--c:#10b981">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon"><i class="bi bi-check-circle"></i></div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-truncate">Active</div>
                    <div class="fs-2 fw-bold" style="color:var(--ink);">@Model.ActiveCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card" style="--c:#f59e0b">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon"><i class="bi bi-star"></i></div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-truncate">Featured</div>
                    <div class="fs-2 fw-bold" style="color:var(--ink);">@Model.FeaturedCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card" style="--c:#0ea5e9">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="kpi-icon"><i class="bi bi-funnel"></i></div>
                <div class="min-w-0">
                    <div class="text-muted small fw-medium text-truncate">Matching filters</div>
                    <div class="fs-2 fw-bold" style="color:var(--ink);">@Model.TotalFiltered</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end" data-autosubmit>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="page" value="1" />

            <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Name, developer or city" />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">City</label>
                <select name="city" class="form-select form-select-sm">
                    <option value="">All cities</option>
                    @foreach (var c in Model.CityOptions)
                    {
                        <option value="@c" selected="@(Model.CityFilter == c)">@c</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All statuses</option>
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Sort by</label>
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="CreatedAt" selected="@(Model.SortBy == "CreatedAt")">Newest</option>
                    <option value="Name" selected="@(Model.SortBy == "Name")">Name</option>
                    <option value="City" selected="@(Model.SortBy == "City")">City</option>
                    <option value="MinPrice" selected="@(Model.SortBy == "MinPrice")">Price</option>
                    <option value="Possession" selected="@(Model.SortBy == "Possession")">Possession</option>
                </select>
            </div>

            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill" title="Apply filters">
                    <i class="bi bi-funnel me-1"></i>Apply
                </button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear all filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>

        @if (hasFilters)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a class="mv-filter-chip" href="@WithoutFilter("search")">“@Model.Search” <i class="bi bi-x"></i></a>
                }
                @if (!string.IsNullOrEmpty(Model.CityFilter))
                {
                    <a class="mv-filter-chip" href="@WithoutFilter("city")"><i class="bi bi-geo-alt"></i>@Model.CityFilter <i class="bi bi-x"></i></a>
                }
                @if (!string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a class="mv-filter-chip" href="@WithoutFilter("status")">@Model.StatusFilter <i class="bi bi-x"></i></a>
                }
            </div>
        }
    </div>
</div>

<!-- Grid -->
@if (Model.Projects.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-building fs-1 text-muted"></i>
            @if (hasFilters)
            {
                <p class="fw-semibold mt-3 mb-1">No projects match these filters</p>
                <p class="text-muted small mb-3">Try a different city or status, or clear the filters.</p>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear filters</a>
            }
            else
            {
                <p class="fw-semibold mt-3 mb-1">No projects yet</p>
                <p class="text-muted small mb-3">Add your first project with photos, pricing and amenities.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Create your first project
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3 g-lg-4 mb-3">
        @foreach (var p in Model.Projects)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none d-block h-100">
                    <div class="project-card">
                        <div class="project-card-img">
                            @if (!string.IsNullOrEmpty(p.HeroImagePath))
                            {
                                <img src="~/@p.HeroImagePath" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-building placeholder-icon"></i>
                            }
                            @if (!string.IsNullOrEmpty(p.Status))
                            {
                                <span class="pc-status @StatusClass(p.Status)"><i></i>@p.Status</span>
                            }
                            @if (p.IsFeatured)
                            {
                                <span class="pc-featured" title="Featured"><i class="bi bi-star-fill"></i></span>
                            }
                            @if (p.ImageCount > 0)
                            {
                                <span class="pc-photos"><i class="bi bi-camera"></i>@p.ImageCount</span>
                            }
                        </div>
                        <div class="project-card-body">
                            <div class="project-card-title text-truncate">@p.Name</div>
                            <div class="project-card-meta text-truncate">
                                <i class="bi bi-geo-alt me-1"></i>@(p.Location ?? p.City ?? "Location not set")
                            </div>
                            <div class="pc-bottom">
                                @if (p.MinPrice.HasValue || p.MaxPrice.HasValue)
                                {
                                    <div class="project-card-price">
                                        @if (p.MinPrice.HasValue && p.MaxPrice.HasValue)
                                        {
                                            <span>₹@p.MinPrice.Value.ToString("N0") – ₹@p.MaxPrice.Value.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span>₹@((p.MinPrice ?? p.MaxPrice)!.Value.ToString("N0"))</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="pc-price-none">Price not set</div>
                                }
                                @if (p.PossessionDate.HasValue)
                                {
                                    <div class="pc-poss"><i class="bi bi-key me-1"></i>@p.PossessionDate.Value.ToString("MMM yyyy")</div>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
                Showing <strong>@(((Model.Page - 1) * Model.PageSize) + 1)</strong>
                –<strong>@(Math.Min(Model.Page * Model.PageSize, Model.TotalFiltered))</strong>
                of <strong>@Model.TotalFiltered</strong> projects
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Projects pages">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page - 1)" aria-label="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" href="@PageUrl(i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(Model.Page + 1)" aria-label="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
}
