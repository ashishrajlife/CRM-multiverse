<div class="modal fade" id="editDealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content border-0 shadow-lg deal-modal">
            <div class="modal-header border-bottom deal-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-warning rounded-3 deal-modal-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Edit Deal</h6>
                        <small class="text-muted" style="font-size:.76rem;">
                            Update the deal and save your changes.
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

               <form asp-action="Edit" method="post" class="deal-form">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deal-Id" name="Id" />

                   <div class="modal-body deal-modal-body">
                    <!-- Lead -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-person-badge"></i></span>
                            <span class="deal-section-title">Lead</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-medium">Attached Lead</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <select id="deal-LeadId" name="LeadId" class="form-select">
                                        <option value="">— No lead —</option>
                                        @foreach (var l in Model.AllLeads)
                                        {
                                            <option value="@l.Id">@l.Display</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>

                                         <!-- Project & Property (prefill) -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-buildings"></i></span>
                            <span class="deal-section-title">Project &amp; Property</span>
                            <span class="deal-section-hint">Optional — prefills below</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Project</label>
                                <select id="editProjectPicker" class="form-select">
                                    <option value="">— Any project —</option>
                                    @foreach (var p in Model.AllProjects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Property</label>
                                <select id="editPropertyPicker" class="form-select">
                                    <option value="">— No property —</option>
                                    @foreach (var pr in Model.AllProperties)
                                    {
                                        <option value="@pr.Id"
                                                data-project-id="@pr.ProjectId"
                                                data-unit="@pr.UnitNumber"
                                                data-title="@pr.Title"
                                                data-project="@pr.ProjectName"
                                                data-bhk="@pr.BHK"
                                                data-city="@pr.City"
                                                data-location="@pr.Location"
                                                data-price="@pr.TotalPrice"
                                                data-carpet="@pr.CarpetArea"
                                                data-builtup="@pr.BuiltUpArea"
                                                data-status="@pr.Status"
                                                data-type="@pr.PropertyType"
                                                data-areaunit="@pr.AreaUnit">
                                            @pr.UnitNumber@(pr.Title != null ? " — " + pr.Title : "")
                                            @(pr.ProjectName != null ? " · " + pr.ProjectName : "")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 d-none" id="editPropertyPreview">
                                <div class="property-preview-card">
                                    <div class="ppc-top">
                                        <div class="ppc-icon"><i class="bi bi-house-check-fill"></i></div>
                                        <div class="ppc-meta">
                                            <div class="ppc-title" id="eppcTitle">—</div>
                                            <div class="ppc-sub" id="eppcSub">—</div>
                                        </div>
                                        <span class="ppc-badge" id="eppcStatus">—</span>
                                    </div>
                                    <div class="ppc-grid">
                                        <div class="ppc-cell"><small>Project</small><b id="eppcProject">—</b></div>
                                        <div class="ppc-cell"><small>BHK</small><b id="eppcBhk">—</b></div>
                                        <div class="ppc-cell"><small>City</small><b id="eppcCity">—</b></div>
                                        <div class="ppc-cell"><small>Location</small><b id="eppcLocation">—</b></div>
                                        <div class="ppc-cell"><small>Carpet</small><b id="eppcCarpet">—</b></div>
                                        <div class="ppc-cell"><small>Built-up</small><b id="eppcBuiltup">—</b></div>
                                        <div class="ppc-cell ppc-price"><small>Total Price</small><b id="eppcPrice">—</b></div>
                                    </div>
                                    <button type="button" class="ppc-clear" id="eppcClear" title="Clear selection">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Commercials -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="deal-section-title">Commercials</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Deal Value <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-Value" name="Value" type="number" step="0.01" required class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Expected Close</label>
                                <input id="deal-ExpectedCloseDateStr" name="ExpectedCloseDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Booking Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-BookingAmount" name="BookingAmount" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Received Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-ReceivedAmount" name="ReceivedAmount" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Stage & Owner -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="deal-section-title">Stage &amp; Owner</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Stage</label>
                                <lookup-select id="deal-Stage" category="DealStage" name="Stage" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Status</label>
                                <select id="deal-Status" name="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="Won">Won</option>
                                    <option value="Lost">Lost</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Owner</label>
                                <input id="deal-OwnerDisplayName" name="OwnerDisplayName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Tags</label>
                                <input id="deal-Tags" name="Tags" class="form-control" placeholder="Comma, separated" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-medium">Notes</label>
                                <textarea id="deal-Notes" name="Notes" rows="2" class="form-control"></textarea>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="modal-footer deal-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-check-lg me-1"></i> Update Deal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>