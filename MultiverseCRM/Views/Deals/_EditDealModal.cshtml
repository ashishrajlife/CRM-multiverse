<div class="modal fade" id="editDealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content border-0 shadow-lg deal-modal">
            <div class="modal-header border-bottom deal-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-warning rounded-3 deal-modal-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Edit Deal</h6>
                        <small class="text-muted" style="font-size:.76rem;">
                            Update the deal and save your changes.
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

               <form asp-action="Edit" method="post" class="deal-form d-flex flex-column" style="min-height:0; flex:1 1 auto; overflow:hidden;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deal-Id" name="Id" />

                   <div class="modal-body deal-modal-body" style="overflow-y:auto; min-height:0; flex:1 1 auto;">
                    <!-- Lead -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-person-badge"></i></span>
                            <span class="deal-section-title">Lead</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-medium">Attached Lead</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <select id="deal-LeadId" name="LeadId" class="form-select">
                                        <option value="">— No lead —</option>
                                        @foreach (var l in Model.AllLeads)
                                        {
                                            <option value="@l.Id">@l.Display</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Property -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-house-door"></i></span>
                            <span class="deal-section-title">Property</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Project</label>
                                <input id="deal-Project" name="Project" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">BHK</label>
                                <select id="deal-BHK" name="BHK" class="form-select">
                                    <option value="">Select BHK…</option>
                                    <option>1BHK</option>
                                    <option>2BHK</option>
                                    <option>3BHK</option>
                                    <option>4BHK</option>
                                    <option>5BHK+</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Location</label>
                                <input id="deal-Location" name="Location" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">City</label>
                                <input id="deal-City" name="City" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Area</label>
                                <div class="input-group">
                                    <input id="deal-AreaSqft" name="AreaSqft" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">sqft</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Commercials -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="deal-section-title">Commercials</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Deal Value <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-Value" name="Value" type="number" step="0.01" required class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Expected Close</label>
                                <input id="deal-ExpectedCloseDateStr" name="ExpectedCloseDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Booking Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-BookingAmount" name="BookingAmount" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Received Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input id="deal-ReceivedAmount" name="ReceivedAmount" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Stage & Owner -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="deal-section-title">Stage &amp; Owner</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Stage</label>
                                <lookup-select id="deal-Stage" category="DealStage" name="Stage" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Status</label>
                                <select id="deal-Status" name="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="Won">Won</option>
                                    <option value="Lost">Lost</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Owner</label>
                                <input id="deal-OwnerDisplayName" name="OwnerDisplayName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Tags</label>
                                <input id="deal-Tags" name="Tags" class="form-control" placeholder="Comma, separated" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-medium">Notes</label>
                                <textarea id="deal-Notes" name="Notes" rows="2" class="form-control"></textarea>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="modal-footer deal-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-check-lg me-1"></i> Update Deal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>