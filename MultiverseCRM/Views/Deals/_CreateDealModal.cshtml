<div class="modal fade" id="addDealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content border-0 shadow-lg deal-modal">
            <div class="modal-header border-bottom deal-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon-aqua rounded-3 deal-modal-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">New Deal</h6>
                        <small class="text-muted" style="font-size:.76rem;">
                            Attach a lead, then set the commercial terms.
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

         <form asp-action="Create" method="post" class="deal-form">
                @Html.AntiForgeryToken()
                
                <div class="modal-body deal-modal-body">
                <!-- Lead -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-person-badge"></i></span>
                            <span class="deal-section-title">Lead</span>
                            <span class="deal-section-hint">Required</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-medium">
                                    Attach Lead <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <select name="LeadId" class="form-select" required>
                                        <option value="">— Select a lead —</option>
                                        @foreach (var l in Model.AllLeads)
                                        {
                                            <option value="@l.Id">@l.Display@(l.Assigned ? " · has other deals" : "")</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-text">
                                    Only leads created in <strong>Leads</strong> can be attached.
                                    If a lead is missing, add it first.
                                </div>
                            </div>
                        </div>
                    </section>

                                        <!-- Project & Property (prefill) -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-buildings"></i></span>
                            <span class="deal-section-title">Project &amp; Property</span>
                            <span class="deal-section-hint">Optional — prefills below</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Project</label>
                               <select id="createProjectPicker" name="ProjectId" class="form-select">
                                    <option value="">— Any project —</option>
                                    @foreach (var p in Model.AllProjects)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                                <div class="form-text">Pick a project to narrow properties.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Property</label>
                                <select id="createPropertyPicker" name="PropertyId" class="form-select">
                                    <option value="">— No property —</option>
                                    @foreach (var pr in Model.AllProperties)
                                    {
                                        <option value="@pr.Id"
                                                data-project-id="@pr.ProjectId"
                                                data-unit="@pr.UnitNumber"
                                                data-title="@pr.Title"
                                                data-project="@pr.ProjectName"
                                                data-bhk="@pr.BHK"
                                                data-city="@pr.City"
                                                data-location="@pr.Location"
                                                data-price="@pr.TotalPrice"
                                                data-carpet="@pr.CarpetArea"
                                                data-builtup="@pr.BuiltUpArea"
                                                data-status="@pr.Status"
                                                data-type="@pr.PropertyType"
                                                data-areaunit="@pr.AreaUnit">
                                            @pr.UnitNumber@(pr.Title != null ? " — " + pr.Title : "")
                                            @(pr.ProjectName != null ? " · " + pr.ProjectName : "")
                                        </option>
                                    }
                                </select>
                                <div class="form-text">Pick a unit to auto-fill details below.</div>
                            </div>

                            <div class="col-12 d-none" id="createPropertyPreview">
                                <div class="property-preview-card">
                                    <div class="ppc-top">
                                        <div class="ppc-icon"><i class="bi bi-house-check-fill"></i></div>
                                        <div class="ppc-meta">
                                            <div class="ppc-title" id="ppcTitle">—</div>
                                            <div class="ppc-sub" id="ppcSub">—</div>
                                        </div>
                                        <span class="ppc-badge" id="ppcStatus">—</span>
                                    </div>
                                    <div class="ppc-grid">
                                        <div class="ppc-cell"><small>Project</small><b id="ppcProject">—</b></div>
                                        <div class="ppc-cell"><small>BHK</small><b id="ppcBhk">—</b></div>
                                        <div class="ppc-cell"><small>City</small><b id="ppcCity">—</b></div>
                                        <div class="ppc-cell"><small>Location</small><b id="ppcLocation">—</b></div>
                                        <div class="ppc-cell"><small>Carpet</small><b id="ppcCarpet">—</b></div>
                                        <div class="ppc-cell"><small>Built-up</small><b id="ppcBuiltup">—</b></div>
                                        <div class="ppc-cell ppc-price"><small>Total Price</small><b id="ppcPrice">—</b></div>
                                    </div>
                                    <button type="button" class="ppc-clear" id="ppcClear" title="Clear selection">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Commercials -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-cash-stack"></i></span>
                            <span class="deal-section-title">Commercials</span>
                            <span class="deal-section-hint">Value required</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">
                                    Deal Value <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input name="Value" type="number" step="0.01" required class="form-control" placeholder="0" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Expected Close</label>
                                <input name="ExpectedCloseDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Booking Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input name="BookingAmount" type="number" step="0.01" class="form-control" placeholder="0" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Received Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@AppOpt.Value.CurrencySymbol</span>
                                    <input name="ReceivedAmount" type="number" step="0.01" class="form-control" placeholder="0" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Stage & Owner -->
                    <section class="deal-section">
                        <div class="deal-section-head">
                            <span class="deal-section-icon"><i class="bi bi-diagram-3"></i></span>
                            <span class="deal-section-title">Stage &amp; Owner</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Stage</label>
                                <lookup-select category="DealStage" name="Stage" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-medium">Owner</label>
                                <input name="OwnerDisplayName" class="form-control" placeholder="Defaults to you" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-medium">Notes</label>
                                <textarea name="Notes" rows="2" class="form-control" placeholder="Any internal context…"></textarea>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="modal-footer deal-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Deal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>